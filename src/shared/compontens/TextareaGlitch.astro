---
interface Props{
  input: {
    id: string | null | undefined;
    placeholder?: string | null | undefined;
    required?: string | boolean | null | undefined;
    value?: string | number | string[] | null | undefined
    dataKey?: string | null | undefined;
  },
  label: {
    labelName: string;
    labelFor: string | null | undefined;
    dataText: string;
  }
}

const { input, label } = Astro.props

const { id, placeholder, required, value, dataKey } = input
const { labelName, labelFor, dataText } = label
---

<div class="glitch-input-wrapper">
  <div class="input-container">
    <textarea
      id={id}
      class="holo-textarea"
      placeholder={placeholder}
      required={required}
      data-key={dataKey}
    >{value}</textarea>
    <label for={labelFor} class="input-label" data-text={dataText}>
      {labelName}
    </label>
    <div class="input-border"></div>
    <div class="input-scanline"></div>
  </div>
</div>

<style>
  /* --- Root Variables & Wrapper --- */
  .glitch-input-wrapper {
    --bg-color: #0d0d0d;
    --primary-color: #00f2ea;
    --secondary-color: #ff0000;
    --text-color: #e5e5e5;
    --glitch-anim-duration: 0.4s;

    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    margin: 1rem;
    width: 100%;
  }

  /* --- Container  --- */
  .input-container {
    position: relative;
    width: 100%;
  }

  /* --- Input --- */
  .holo-textarea {
    width: 100%;
    height: 6rem;
    background: rgba(13, 13, 13, 0.7);
    border: none;
    border-radius: 10px;
    outline: none;
    resize: none;
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 1.1rem;
    caret-color: var(--primary-color);
    z-index: 10;
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }

  /* --- Floating Label --- */
  .input-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: var(--text-color);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    pointer-events: none;
    transition: all 0.3s ease;
    z-index: 11;
  }
  .holo-textarea:focus + .input-label,
  .holo-textarea:not(:placeholder-shown) + .input-label {
    top: -1.5rem;
    left: 0;
    font-size: 0.8rem;
    opacity: 1;
    color: var(--primary-color);
  }

  .holo-textarea:focus + .input-label::before,
  .holo-textarea:focus + .input-label::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #212121;
  }
  .holo-textarea:focus + .input-label::before {
    color: var(--secondary-color);
    animation: glitch-label var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  .holo-textarea:focus + .input-label::after {
    color: var(--primary-color);
    animation: glitch-label var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) reverse both;
  }

  /* --- Decorative Layers --- */
  .input-border,
  .input-scanline {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .input-border {
    border-radius: 10px;
    border: 1px solid rgba(0, 242, 234, 0.2);
    opacity: 0.5;
    transition: all 0.3s ease;
  }

  .input-scanline {
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 242, 234, 0.1) 48%,
      rgba(0, 242, 234, 0.3) 50%,
      rgba(0, 242, 234, 0.1) 52%,
      transparent 100%
    );
    opacity: 0;
  }

  /* --- Data Visualization --- */
  .holo-textarea:focus {
    border-color: transparent;
  }
  .holo-textarea:focus ~ .input-border {
    border-radius: 10px;
    opacity: 1;
    border-color: rgba(0, 242, 234, 0.5);
  }
  .holo-textarea:focus ~ .corner {
    width: 1.25rem;
    height: 1.25rem;
    border-width: 3px;
    opacity: 1;
  }
  .holo-textarea:focus {
    opacity: 1;
  }
  .holo-textarea:focus ~ .input-scanline {
    animation: scan-vertical 4s linear infinite;
  }
  .holo-textarea:focus {
    opacity: 1;
  }

  /* --- Keyframes --- */
  @keyframes glitch-label {
    0% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
    20% {
      transform: translate(-0.2rem, 0.1rem);
      clip-path: inset(50% 0 20% 0);
    }
    40% {
      transform: translate(0.1rem, -0.1rem);
      clip-path: inset(20% 0 60% 0);
    }
    60% {
      transform: translate(-0.15rem, 0.1rem);
      clip-path: inset(80% 0 5% 0);
    }
    80% {
      transform: translate(0.15rem, -0.15rem);
      clip-path: inset(30% 0 45% 0);
    }
    100% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes scan-vertical {
    0% {
      opacity: 0;
      transform: translateY(-100%);
    }
    25% {
      opacity: 0.5;
    }
    75% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  @keyframes data-pulse {
    0%,
    100% {
      transform: scaleY(0.2);
      opacity: 0.3;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.8;
    }
  }
  
  /* --- Glitch effect for border --- */
  .holo-textarea:focus ~ .input-border {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 10px;
    border: 1px solid var(--primary-color);
    animation: glitch-border var(--glitch-anim-duration) steps(2, end) alternate;
    opacity: 1;
  }

  /* --- Keyframes for glitch border --- */
  @keyframes glitch-border {
    0% {
      transform: translate(0, 0);
      box-shadow: 0 0 3px var(--primary-color);
    }
    20% {
      transform: translate(-1px, 1px);
      box-shadow: -2px 2px 4px var(--secondary-color);
    }
    40% {
      transform: translate(1px, -1px);
      box-shadow: 2px -2px 4px var(--primary-color);
    }
    60% {
      transform: translate(-1px, -1px);
      box-shadow: -2px -2px 4px var(--secondary-color);
    }
    80% {
      transform: translate(1px, 1px);
      box-shadow: 2px 2px 4px var(--primary-color);
    }
    100% {
      transform: translate(0, 0);
      box-shadow: 0 0 3px var(--secondary-color);
    }
  }

</style>