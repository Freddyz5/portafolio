// src/pages/index.astro
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Redirecting...</title>
  <script>
    // Detectar idioma del navegador
    const browserLang = navigator.language.split('-')[0];
    const supportedLangs = ['es', 'en'];
    const lang = supportedLangs.includes(browserLang) ? browserLang : 'es';
    
    // Redirigir a /[lang]/portafolio
    window.location.href = `/${lang}/portafolio`;
  </script>
  <meta http-equiv="refresh" content="0; url=/es/portafolio">
</head>
<body>
  <p>Redirecting to <a href="/es/portafolio">/es/portafolio</a>...</p>
</body>
</html>