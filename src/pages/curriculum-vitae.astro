---
import LayoutCV from '../modules/cv/layout/Layout.astro';
import CV from '../modules/cv/index.astro';
import ButtonTranslate from 'src/shared/compontens/ButtonTranslateCV.astro';
import { getData } from '../shared/services/getData';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;

const data = await getData(lang !== 'es' && lang !== 'en' ? 'en' : lang) as any;
const basics = data.basics;
---

<LayoutCV
  title={`Curriculum de ${basics.name} - ${basics.label}`}
  image={basics.image}
  summary={basics.summary}
  url={basics.url}
>
  <ButtonTranslate currentLang={lang} />
  <CV data={data} />
</LayoutCV>