---
import Layout from "src/modules/configurations/layout/Layout.astro";
import Configurations from "src/modules/configurations/index.astro";
import { getData } from "src/modules/configurations/services/getData";

const endpoint = import.meta.env.PUBLIC_JSON_ENDPOINT;

const data = await getData();
---

<Layout
  title="Configuraciones"
  description="Configuraciones"
>
  <Configurations endpoint={endpoint} data={data} />
</Layout>