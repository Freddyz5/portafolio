---
import Layout from 'src/modules/portfolio/layout/Layout.astro';
import { getData } from '../../../shared/services/getData';
import ProjectPage from '../../../modules/portfolio/ProjectPage.astro';
import { PROJECT_LINKS } from 'src/modules/portfolio/layout/constants/links';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as { lang: 'es' | 'en' };

const data = await getData(lang !== 'es' && lang !== 'en' ? 'en' : lang) as any;
const { basics } = data;
---

<Layout
  title={`Portfolio de ${basics.name} - ${basics.label}`}
  image={basics.image}
  summary={basics.summary}
  url={basics.url}
  lang={lang}
  links={PROJECT_LINKS}
>
  <ProjectPage data={data} />
</Layout>