---
import Layout from 'src/modules/portfolio/layout/Layout.astro';
import { separateLanguages } from '../../shared/utils/languageSeparator';
import resume from '../../constants/resume.json';
import ProjectPage from '../../modules/portfolio/ProjectPage.astro';
import { PROJECT_LINKS } from '../../modules/portfolio/layout/constants/links';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const BASE_URL = import.meta.env.BASE_URL;
const { lang } = Astro.params as { lang: 'es' | 'en' };

const data = separateLanguages(resume, lang !== 'es' && lang !== 'en' ? 'en' : lang) as any;
const { basics } = data;

const PROJECT_LINKS_ = PROJECT_LINKS.map(link => {
  return {
    ...link,
    href: `${BASE_URL}/${lang}/#${link.id}`
  };
});
---

<Layout
  title={`Portfolio de ${basics.name} - ${basics.label}`}
  image={basics.image}
  summary={basics.summary}
  url={basics.url}
  lang={lang}
  links={PROJECT_LINKS_}
>
  <ProjectPage data={data} />
</Layout>