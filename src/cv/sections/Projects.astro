---
import Section from "../components/Section.astro";

import { projects } from "@cv"
---

<Section title="Proyectos">
  <ul class="works">
    {
      projects.map(
        ({ name, startDate, endDate, isActive, description, highlights, url }) => {
          const formattedDate = (date: string) => {
            const formattedDate = new Date(date).toLocaleString('es-ES', { year: 'numeric', month: 'long'});
            const result = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1).replace(' de', '');
            return result;
          }

          const startYear = formattedDate(startDate)
          const endYear = endDate !== null ? formattedDate(endDate) : "Actualidad"

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      <a href={url} title={`Ver ${name}`} target="_blank">
                        {name}
                      </a>
                      <h4>{isActive ? "En desarrollo" : ""}</h4>
                    </h3>
                  </div>

                  <time>{startYear} - {endYear}</time>
                </header>

                <footer>
                  <p class="description">{description}</p>
                  <ul class="highlights">
                    {highlights.map((highlight) => (
                      <li>
                        <p>{highlight}</p>
                      </li>
                    ))}
                  </ul>
                </footer>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  header div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  .description {
    position: relative;
    padding-left: 1.5rem;
  }

  .description::before{
    content: "▪";
    font-size: 1rem;
    color: #000000;
    position: absolute;
    left: 2px;
  }

  .highlights {
    padding-left: 3rem;
    list-style: disc;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>