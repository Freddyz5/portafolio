---
import SquareChevronRight from "src/shared/icons/SquareChevronRight.astro";
import Chip from "../components/Chip.astro";
import Github from "src/shared/icons/Github.astro";
import Link from "src/shared/icons/Link.astro";

interface Props {
  id?: string | null | undefined;
  name: string;
  image?: string;
  summary?: string;
  description: string;
  technologies: string[];
  url: string;
  repo: string;
}

const { id, name, image, summary, description, technologies, url, repo } = Astro.props;
---

<article id={id} data-project-id={id} class="project-card" >
  <header>
    <SquareChevronRight />
    <h5>{name.split(" ").join("_")}</h5>
  </header>
  <figure>
    <img
      src={image ?? "https://images.unsplash.com/photo-1688377051459-aebb99b42bff?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjeWJlcnB1bmslMjBjaXR5JTIwbmVvbnxlbnwxfHx8fDE3NjMwNzkzODd8MA&ixlib=rb-4.1.0&q=80&w=1080"}
      alt="Project Image"
      width="100%"
      height="100%"
    />
  </figure>
  <div class="content">
    <h4>{name}</h4>

    <p>{ summary ? summary  : description }</p>

    <div class="stack-tags">
      {technologies.map((tech: string) => <Chip text={tech} />)}
    </div>

    <div class="links">
      {repo ? (
        <a href={repo} target="_blank" rel="noopener noreferrer" class="repo">
          <Github width="18" height="18" />
          Code
        </a>
      ) : (
        <span class="repo disabled">
          <Github width="18" height="18" />
          Code
        </span>
      )}

      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="url">
          <Link width="18" height="18" />
          Demo
        </a>
      ) : (
        <span class="url disabled">
          <Link width="18" height="18" />
          Demo
        </span>
      )}
    </div>
  </div>
</article>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const BASE_URL = import.meta.env.BASE_URL;
		const cards = document.querySelectorAll('.project-card');
		
		cards.forEach(card => {
			card.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				// Si el click es en un enlace, no redirigir
				if (target.tagName === 'A' || target.closest('a')) {
					return;
				}
				
				const projectId = card.getAttribute('data-project-id');
				const lang = window.location.pathname.includes('/es/') ? 'es' : 'en';
				window.location.href = `${BASE_URL}/${lang}/projects?id=${projectId}`;
			});
		});
	});
</script>

<style>
  article {
    max-width: 500px;
    width: 100%;
    background: var(--bg-base);
    border: 2px solid var(--red-muted);
    border-radius: 5px;
    transition: all 0.3s ease;
  }
  article:hover {
    transform: translateY(-4px);
    border-color: var(--red-glow);
  }
  header {
    padding: 0.5rem;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--red-muted);
  }
  figure {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }
  img {
    transition: all 0.4s ease;
  }
  article:hover img {
    transform: scale(1.05);
  }
  .content {
    width: 100%;
    padding: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .content h4 {
    color: var(--red-glow);
  }
  .content p {
    height: 3.8rem;
    color: var(--red-core);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stack-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .links {
    display: flex;
    gap: 0.8em;
  }
  .links a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--red-core);
  }
  .links a:hover {
    color: var(--cyan-glow);
    text-decoration: underline;
  }
  .links .disabled {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--red-muted);
    cursor: not-allowed;
    opacity: 0.6;
    pointer-events: none;
  }
</style>