---
import SquareChevronRight from "src/shared/icons/SquareChevronRight.astro";
import Chip from "../components/Chip.astro";
import Github from "src/shared/icons/Github.astro";
import Link from "src/shared/icons/Link.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  id?: string | null | undefined;
  lang: "es" | "en";
  name: string;
  image?: string;
  summary?: string;
  description: string;
  technologies: string[];
  url: string;
  repo: string;
  projectStatus?: "active" | "finished" | "cancelled" | "personal";
  showStatus?: boolean;
}

const {
  id,
  lang,
  name,
  image,
  summary,
  description,
  technologies,
  url,
  repo,
  projectStatus,
  showStatus = false,
} = Astro.props;

// Chips visibles en la tarjeta (el stack completo se ve en el detalle).
const STACK_LIMIT = 5;
const shown = technologies?.slice(0, STACK_LIMIT) ?? [];
const extra = (technologies?.length ?? 0) - shown.length;

const BASE_URL = import.meta.env.BASE_URL;
const href = `${BASE_URL}/${lang}/projects?id=${id}`;

// Pareja de morph con ProjectsDetail: mismos nombres a ambos lados de la
// navegación. Los ids de resume.json ya son identificadores CSS válidos.
// La clase project-morph es la que recoge duración/curva en Layout.astro.
const vtFigure = id
  ? `view-transition-name: project-img-${id}; view-transition-class: project-morph project-media;`
  : undefined;
const vtTitle = id
  ? `view-transition-name: project-title-${id}; view-transition-class: project-morph;`
  : undefined;
---

<article id={id} data-project-id={id} class="project-card interactive">
  <header>
    <SquareChevronRight />
    <h5 style={vtTitle}>{name.split(" ").join("_")}</h5>
    {showStatus && projectStatus && (
      <StatusBadge lang={lang} status={projectStatus} />
    )}
  </header>
  <figure style={vtFigure}>
    <img
      src={image ?? "https://images.unsplash.com/photo-1688377051459-aebb99b42bff?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjeWJlcnB1bmslMjBjaXR5JTIwbmVvbnxlbnwxfHx8fDE3NjMwNzkzODd8MA&ixlib=rb-4.1.0&q=80&w=1080"}
      alt="Project Image"
      width="100%"
      height="100%"
    />
  </figure>
  <div class="content">
    <h4 class="card-title"><a class="card-link" href={href}>{name}</a></h4>

    <p>{ summary ? summary  : description }</p>

    <div class="stack-tags">
      {shown.map((tech: string) => <Chip text={tech} color="var(--cyan-accent)" />)}
      {extra > 0 && <span class="stack-more">+{extra}</span>}
    </div>

    <div class="links">
      {repo ? (
        <a href={repo} target="_blank" rel="noopener noreferrer" class="repo">
          <Github width="18" height="18" />
          Code
        </a>
      ) : (
        <span class="repo disabled">
          <Github width="18" height="18" />
          Code
        </span>
      )}

      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="url">
          <Link width="18" height="18" />
          Demo
        </a>
      ) : (
        <span class="url disabled">
          <Link width="18" height="18" />
          Demo
        </span>
      )}
    </div>
  </div>
</article>

<style>
  article {
    --card-border: var(--red-muted);
    --card-body: var(--red-core);
    --card-meta: var(--red-muted);
    --card-link: var(--cyan-accent);

    position: relative;
    max-width: 500px;
    width: 100%;
    background: var(--bg-base);
    border: 1px solid var(--card-border);
    border-radius: 5px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  header {
    padding: 0.5rem 0.7rem;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--card-meta);
    font-family: var(--font-body);
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }
  header h5 { font-weight: 500; flex: 1; }
  figure {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }
  img {
    transition: transform 0.4s ease;
  }
  .content {
    width: 100%;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 1;
  }
  .content h4 {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 600;
  }
  .card-title {
    color: var(--red-core);
    transition: color 0.3s ease;
  }
  .card-link {
    color: inherit;
    text-decoration: none;
  }
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: none;
  }
  article:has(.card-link:focus-visible) {
    outline: 2px solid var(--cyan-glow);
    outline-offset: 2px;
  }
  .content p {
    height: auto;
    color: var(--card-body);
    transition: color 0.3s ease;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stack-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .stack-more {
    font-family: var(--font-terminal);
    font-size: 0.85em;
    letter-spacing: 0.05em;
    color: var(--card-meta);
    padding: 0.1em 0.3em;
    transition: color 0.3s ease;
  }
  .links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 0.8em;
    margin-top: auto;
    align-self: flex-start;
  }
  .links a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--card-link);
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }
  .links a:hover {
    color: var(--cyan-glow);
    text-shadow: var(--text-glow-cyan);
    text-decoration: underline;
  }
  .links .disabled {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--card-meta);
    cursor: not-allowed;
    opacity: 0.6;
    pointer-events: none;
    transition: color 0.3s ease;
  }
  article:hover img,
  article:focus-within img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    article:hover img,
    article:focus-within img {
      transform: none;
    }
    img { transition: none; }
  }
</style>
