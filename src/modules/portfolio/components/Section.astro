---
interface Props {
  id?: string | null | undefined;
  title: string;
  subTittle?: string
  styles?: {
    height?: string;
    backgroundColor?: string;
    boxShadow?: string;
  };
}

const { id, title, subTittle, styles } = Astro.props;
---

<section id={id} style={`height: ${styles?.height}; background-color: ${styles?.backgroundColor}; box-shadow: ${styles?.boxShadow};`}>
  <header>
    {title && <div class="title-wrapper">
      <div class="experience-title-line" />
      <h1 class="glow-red">{title}</h1>
    </div>}
    {subTittle && <p>{">"} {subTittle}</p>}
  </header>
  <slot />
</section>

<style>
  section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem;
    /* scroll-margin-top: 3em; */
  }
  header {
    max-width: 1140px;
    width: 100%;
    text-align: start;
    margin-bottom: 2rem;
  }
  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .experience-title-line {
    height: 4px;
    width: 3rem;
    background-color: var(--red-glow);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 600;
    /* color + glow los aporta la utilidad global .glow-red */
    text-transform: uppercase;
  }
  p {
    font-family: var(--font-terminal);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--red-muted);
  }
</style>