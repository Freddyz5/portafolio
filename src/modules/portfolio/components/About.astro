---
import ButtonGlitch from "../components/ButtonGlitch.astro";
import Section from "./Section.astro";

interface Props {
  lang: "es" | "en";
  summary: string;
  name: string;
  image: {
    url1: string;
    url2: string;
    alt: string;
  };
}

const { lang, summary, name, image } = Astro.props;

const cvHref = `${import.meta.env.BASE_URL}/${lang}/cv`;

const nameSlug = name.toLocaleUpperCase();
const deniedLabel = lang === "es" ? "> ACCESO_DENEGADO" : "> ACCESS_DENIED";
---
<Section
  id="about"
  title={lang === "es" ? "Acerca de mí" : "About me"}
  subTittle={lang === "es" ? "REGISTRO_PERSONAL" : "PERSONAL_RECORD" }
  styles={{
    backgroundColor: "var(--bg-band)",
    height: "800px",
    boxShadow: "0 0 50px 20px var(--bg-band)"
  }}
>
  <article>
    <div class="summary-wrapper">
      <p>{summary}</p>

      <div class="buttons-wrapper">
        <ButtonGlitch
          id="resume-btn"
          text={lang === "es" ? "Currículum" : "Resume"}
          width="100%"
          variant="secondary"
          href={cvHref}
        />
        <ButtonGlitch
          id="contact-btn"
          text={lang === "es" ? "Contacto" : "Contact"}
          href="#contact"
          variant="quiet"
          tone="muted"
          width="100%"
        />
      </div>
    </div>

    <figure id="about-photo" role="button" tabindex="0" aria-label={name}>
      <img
        class="picture normal"
        src={image.url1}
        alt={image.alt}
        loading="lazy"
      />
      <img
        class="picture pixel"
        src={image.url2}
        alt={image.alt}
        loading="lazy"
      />
      <figcaption>{nameSlug}</figcaption>
      <span class="denied-msg" aria-live="polite" data-text={deniedLabel}></span>
    </figure>
  </article>
</Section>

<style>
  article {
    display: flex;
    flex-direction: row;
    justify-content: center;
    max-width: 1140px;
    width: 100%;
    height: 400px;
    gap: 5rem;
  }
  .summary-wrapper {
    width: 60%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
  }
  .summary-wrapper p {
    height: 60%;
    overflow: auto;
    color: var(--cyan-core);
  }
  .buttons-wrapper {
    width: 100%;
    display: flex;
    gap: 1rem;
  }

  figure {
    position: relative;
    width: 450px;
    height: 400px;
    border: 2px solid color-mix(in srgb, var(--red-glow) 50%, transparent);
    border-radius: 5px;
    cursor: pointer;
    color: var(--red-core);
    background-image:
			radial-gradient(
				circle at center center,
				transparent 0%,
				var(--white-transparent) 99%
			),
			repeating-linear-gradient(
				0deg,
				color-mix(in srgb, var(--red-muted) 50%, transparent) 0px,
				color-mix(in srgb, var(--red-muted) 50%, transparent) 1px,
				transparent 1px,
				transparent 24px
			),
			repeating-linear-gradient(
				90deg,
				color-mix(in srgb, var(--red-muted) 50%, transparent) 0px,
				color-mix(in srgb, var(--red-muted) 50%, transparent) 1px,
				transparent 1px,
				transparent 24px
			),
			linear-gradient(90deg, var(--white-transparent), var(--white-transparent));
    transition: all 2s ease;
  }
  figure:hover {
    border-color: var(--cyan-glow);
    transition: all 2s ease;
  }

  figure img {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 85%;
    object-fit: cover;
    transition: all 2s ease;
  }
  figcaption {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-terminal);
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--red-core);
    transition: color 2s ease;
  }

  figure:hover figcaption {
    color: var(--cyan-glow);
  }

  .pixel {
    opacity: 1;
    z-index: 2;
  }

  .normal {
    opacity: 1;
    z-index: 1;
  }

  figure:hover .pixel {
    opacity: 0;
  }
  figure:hover .picture {
    filter: drop-shadow(0px 0px 10px var(--cyan-glow));
  }
  .picture {
    width: min(70vw, 360px);
    padding: 10px 10px 0 10px;
    filter: drop-shadow(0px 0px 10px var(--red-muted));
    mask-image: linear-gradient(
        black 90%,
        transparent
    );
  }
  @media (max-width: 900px) {
    /* Al apilar en columna el contenido supera los 800px fijos de la sección:
       se libera la altura para que no se recorte ni solape la sección vecina.
       #about vive en el DOM de Section.astro, no en el de este componente: el
       scoping de Astro aplicaría el hash equivocado sin :global(). */
    :global(#about) { height: auto !important; }
    article {
      flex-direction: column;
      height: auto;
      gap: 2.5rem;
      align-items: center;
    }
    .summary-wrapper {
      width: 100%;
      height: auto;
    }
    .summary-wrapper p {
      height: auto;
    }
    figure {
      width: min(90vw, 450px);
    }
  }
  @media (max-width: 600px) {
    .buttons-wrapper {
      flex-direction: column;
    }
  }
</style>

<script>
  import { wireDeniedGesture } from "src/shared/utils/deniedGesture";

  const photo = document.getElementById("about-photo");
  if (photo) wireDeniedGesture(photo);
</script>
