---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span>
  {text}
</span>

<style>
  span {
    color: var(--color-muted);
    font-size: 0.75em;
    border: 2px solid var(--color-muted);
    border-radius: 3px;
    padding: 0.2em 0.6em;
    transition: all 0.3s ease;
  }
  span:hover {
    color: var(--color-secondary-accent);
    border-color: var(--color-secondary-accent);
  }
</style>