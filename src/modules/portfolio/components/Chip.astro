---
interface Props {
  text: string;
  color?: string;
}

const { text, color = 'var(--red-muted)' } = Astro.props;
---

<span>
  {text}
</span>

<style define:vars={{ color }}>
  span {
    color: var(--chip-color, var(--red-muted));
    font-size: 0.75em;
    border: 2px solid var(--chip-color, var(--red-muted));
    border-radius: 3px;
    padding: 0.2em 0.6em;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
</style>