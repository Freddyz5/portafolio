---
interface Props {
  text: string;
  color?: string;
}

const { text, color = 'var(--red-muted)' } = Astro.props;
---

<span>
  {text}
</span>

<style define:vars={{ color }}>
  span {
    color: var(--color);
    font-size: 0.75em;
    border: 2px solid var(--color);
    border-radius: 3px;
    padding: 0.2em 0.6em;
    transition: all 0.3s ease;
  }
  span:hover {
    color: var(--cyan-accent);
    border-color: var(--cyan-accent);
  }
</style>