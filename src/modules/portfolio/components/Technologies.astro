---
import Section from "./Section.astro";
import Chip from "./Chip.astro";

interface Bay {
  bay: string;
  label: string;
  items: string[];
}
interface PrimaryBay extends Bay {
  tag: string;
  note: string;
}

interface Props {
  lang: "es" | "en";
  techBays: {
    primary: PrimaryBay;
    secondary: Bay[];
  };
}

const { lang, techBays } = Astro.props;
const { primary, secondary } = techBays;
const deniedLabel = lang === "es" ? "> ACCESO_DENEGADO" : "> ACCESS_DENIED";
---

<Section
  id="technologies"
  title={lang === "es" ? "Tecnologías" : "Technologies"}
  subTittle={lang === "es" ? "BAHÍAS_DE_CARGA • INVENTARIO" : "CARGO_BAYS • INVENTORY"}
>
  <div class="bays">
    <!-- Bahía primaria: destacada (borde rojo, chips cian grandes, etiqueta ámbar) -->
    <article class="bay bay--primary" tabindex="0" role="button" aria-label={primary.label}>
      <header>
        <h3 class="glow-red">{primary.label}</h3>
        <span class="bay-tag glow-amber">{primary.bay} · {primary.tag}</span>
      </header>
      <div class="bay-chips">
        {primary.items.map((t) => <Chip text={t} color="var(--cyan-glow)" />)}
      </div>
      <p class="bay-note">{primary.note}</p>
      <span class="denied-msg" aria-live="polite" data-text={deniedLabel}></span>
    </article>

    <!-- Bahías secundarias: tenues -->
    {secondary.map((bay) => (
      <article class="bay bay--secondary" tabindex="0" role="button" aria-label={bay.label}>
        <header>
          <h4>{bay.label}</h4>
          <span class="bay-code">{bay.bay}</span>
        </header>
        <div class="bay-chips">
          {bay.items.map((t) => <Chip text={t} color="var(--cyan-accent)" />)}
        </div>
        <span class="denied-msg" aria-live="polite" data-text={deniedLabel}></span>
      </article>
    ))}
  </div>
</Section>

<style>
  .bays {
    max-width: 1140px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: stretch;
  }
  .bay--primary {
    grid-column: span 2;
  }

  .bay {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border-radius: 5px;
    background-color: var(--bg-base);
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .bay header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .bay-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-content: flex-start;
  }

  /* ===== Bahía primaria ===== */
  .bay--primary {
    border: 1px solid color-mix(in srgb, var(--red-glow) 55%, transparent);
    background-color: var(--bg-raised);
  }
  .bay--primary h3 {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .bay-tag {
    font-family: var(--font-terminal);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .bay--primary .bay-chips {
    font-size: 1.05rem;
  }
  .bay-note {
    margin-top: auto;
    font-size: var(--fs-meta);
    letter-spacing: 0.03em;
    color: var(--red-muted);
  }
  /* Hover mínimo: solo intensifica su propio borde rojo — no toma prestado el
     cian (esa señal es "hay datos", y una bahía no revela nada). Sin elevación.
     El anillo de foco por teclado se deja al :focus-visible global (Layout.astro):
     el borde/glow de aquí es sutil a propósito, no alcanza solo como indicador. */
  .bay--primary:hover,
  .bay--primary:focus-visible {
    border-color: var(--red-glow);
  }

  /* ===== Bahías secundarias ===== */
  .bay--secondary {
    border: 1px solid color-mix(in srgb, var(--red-muted) 50%, transparent);
  }
  /* Hover mínimo: solo borde cian + glow sutil, sin elevación ni repintado.
     El anillo de foco por teclado lo aporta el :focus-visible global. */
  .bay--secondary:hover,
  .bay--secondary:focus-visible {
    border-color: var(--cyan-glow);
    box-shadow: 0 0 6px color-mix(in srgb, var(--cyan-glow) 30%, transparent);
  }
  .bay--secondary h4 {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--red-core) 80%, transparent);
  }
  .bay-code {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    letter-spacing: 0.1em;
    color: var(--red-muted);
  }
  .bay--secondary .bay-chips {
    font-size: 0.9rem;
  }

  /* El shake de "acceso denegado" (.denied/.denied-msg + @keyframes
     denied-shake) es global — ver Layout.astro — para que la foto de About
     pueda compartir el mismo gesto. */

  @media (max-width: 900px) {
    .bays {
      grid-template-columns: repeat(2, 1fr);
    }
    .bay--primary {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .bays {
      grid-template-columns: 1fr;
    }
    .bay--primary {
      grid-column: auto;
    }
  }
</style>

<script>
  import { wireDeniedGesture } from "src/shared/utils/deniedGesture";

  document.querySelectorAll<HTMLElement>(".bay").forEach(wireDeniedGesture);
</script>
