---
import Section from "./Section.astro";
import Chip from "./Chip.astro";

interface Bay {
  bay: string;
  label: string;
  items: string[];
}
interface PrimaryBay extends Bay {
  tag: string;
  note: string;
}

interface Props {
  lang: "es" | "en";
  techBays: {
    primary: PrimaryBay;
    secondary: Bay[];
  };
}

const { lang, techBays } = Astro.props;
const { primary, secondary } = techBays;
---

<Section
  id="technologies"
  title={lang === "es" ? "Tecnologías" : "Technologies"}
  subTittle={lang === "es" ? "BAHÍAS_DE_CARGA • INVENTARIO" : "CARGO_BAYS • INVENTORY"}
>
  <div class="bays">
    <!-- Bahía primaria: destacada (borde rojo, chips cian grandes, etiqueta ámbar) -->
    <article class="bay bay--primary">
      <header>
        <h3 class="glow-red">{primary.label}</h3>
        <span class="bay-tag glow-amber">{primary.bay} · {primary.tag}</span>
      </header>
      <div class="bay-chips">
        {primary.items.map((t) => <Chip text={t} color="var(--cyan-glow)" />)}
      </div>
      <p class="bay-note">{primary.note}</p>
    </article>

    <!-- Bahías secundarias: tenues -->
    {secondary.map((bay) => (
      <article class="bay bay--secondary">
        <header>
          <h4>{bay.label}</h4>
          <span class="bay-code">{bay.bay}</span>
        </header>
        <div class="bay-chips">
          {bay.items.map((t) => <Chip text={t} color="var(--cyan-accent)" />)}
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  .bays {
    max-width: 1140px;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    align-items: stretch;
  }
  .bay--primary {
    grid-column: span 2;
  }

  .bay {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border-radius: 5px;
    background-color: var(--bg-base);
  }
  .bay header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .bay-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-content: flex-start;
  }

  /* ===== Bahía primaria ===== */
  .bay--primary {
    border: 1px solid color-mix(in srgb, var(--red-glow) 55%, transparent);
    background-color: var(--bg-raised);
  }
  .bay--primary h3 {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .bay-tag {
    font-family: var(--font-terminal);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .bay--primary .bay-chips {
    font-size: 1.05rem;
  }
  .bay-note {
    margin-top: auto;
    font-size: var(--fs-meta);
    letter-spacing: 0.03em;
    color: var(--red-muted);
  }

  /* ===== Bahías secundarias ===== */
  .bay--secondary {
    border: 1px solid color-mix(in srgb, var(--red-muted) 50%, transparent);
  }
  .bay--secondary h4 {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--red-core) 80%, transparent);
  }
  .bay-code {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    letter-spacing: 0.1em;
    color: var(--red-muted);
  }
  .bay--secondary .bay-chips {
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .bays {
      grid-template-columns: repeat(2, 1fr);
    }
    .bay--primary {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .bays {
      grid-template-columns: 1fr;
    }
    .bay--primary {
      grid-column: auto;
    }
  }
</style>
