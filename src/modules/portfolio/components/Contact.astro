---
import InputGlitch from "./InputGlitch.astro";
import ButtonGlitch from "./ButtonGlitch.astro";
import Section from "./Section.astro";
import TextareaGlitch from "./TextareaGlitch.astro";
import Email from '../../../shared/icons/Mail.astro';
import LinkedIn from '../../../shared/icons/Linkedin.astro';
import GitHub from '../../../shared/icons/Github.astro';
import type { AstroComponentFactory } from 'astro/dist/runtime/server';

interface Props {
  lang: "es" | "en";
  basics: any;
}

const { lang, basics } = Astro.props;
const { socialProfiles } = basics;

socialProfiles.push({
  network: "Email",
  url: `mailto:${basics.email}`,
  username: basics.email,
});

const SOCIAL_ICONS: Record<string, AstroComponentFactory> = {
  Email,
  GitHub,
  LinkedIn,
}
---

<Section
  id="contact"
  title={lang === "es" ? "Iniciar Contacto" : "Initiate Contact"}
  subTittle={lang === "es" ? "CANAL_DE_COMUNICACIONES_ABIERTO" : "OPEN_COMMUNICATION_CHANNEL"}
  styles={{
    backgroundColor: "var(--bg-field)",
    height: "1000px",
    boxShadow: "0 0 50px 20px var(--bg-field)"
  }}
>
  <header>Contact_interface</header>
  <article>
    <div class="contact-info">
      {socialProfiles && socialProfiles.map(({ network, url, username }: { network: string; url: string; username: string }) => {
        const Icon = SOCIAL_ICONS[network]
        if (!Icon) return null;
        return (
          <a href={url} target="_blank" rel="noopener noreferrer">
            <Icon width="50" height="50" />
            <p class="network">{network}</p>
            <p class="username">
              { network === "LinkedIn" && "/in/" + username }
              { network === "GitHub" && "@" + username }
              { network === "Email" && username }
            </p>
          </a>
        )
      })}
    </div>

    <p>{">"} {lang === "es" ? "ENVIAR MENSAJE" : "SEND MESSAGE"}</p>

    <form class="contact-form">
    <!-- <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="f7108cef-5c2e-47ca-9f49-981de47c8bea"> -->
      <div class="two-inputs">
        <InputGlitch
          input={{
            id: "name",
            name: "name",
            type: "text",
            placeholder: lang === "es" ? "Tu nombre" : "Your name",
            required: true,
          }}
          margin="0"
        />
        <InputGlitch
          input={{
            id: "email",
            name: "email",
            type: "email",
            placeholder: lang === "es" ? "Tu correo electrónico" : "Your email",
            required: true,
          }}
          margin="0"
        />
      </div>

      <InputGlitch
        input={{
          id: "subject",
          name: "subject",
          type: "text",
          placeholder: lang === "es" ? "Tu asunto" : "Your subject",
          required: true,
        }}
        margin="0"
      />
      
      <TextareaGlitch
        input={{
          id: "message",
          name: "message",
          placeholder: lang === "es" ? "Tu mensaje" : "Your message",
          required: true,
        }}
        label={{
          labelFor: "message",
          dataText: lang === "es" ? "Mensaje" : "Message",
        }}
      />
      <ButtonGlitch
        type="submit"
        text={(lang === "es" ? "Enviar" : "Send").toUpperCase()}
      />
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </article>
</Section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const accessKey = import.meta.env.PUBLIC_ACCESS_KEY_EMAIL;
    const form = document.querySelector(".contact-form") as HTMLFormElement;
    if (!form) return;

    const status = form.querySelector(".form-status") as HTMLElement | null;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const lang = document.documentElement.lang === "en" ? "en" : "es";

    const T = {
      es: {
        sending: "Enviando…",
        ok: "✓ Mensaje enviado",
        err: "✕ Error al enviar. Inténtalo de nuevo.",
      },
      en: {
        sending: "Sending…",
        ok: "✓ Message sent",
        err: "✕ Sending failed. Please try again.",
      },
    }[lang];

    const setStatus = (text: string, state: "sending" | "ok" | "err" | "") => {
      if (!status) return;
      status.textContent = text;
      status.dataset.state = state;
    };
    const setBusy = (busy: boolean) => {
      if (!submitBtn) return;
      submitBtn.disabled = busy;
      submitBtn.classList.toggle("is-disabled", busy);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault(); // evita redirección

      setBusy(true);
      setStatus(T.sending, "sending");

      const formData = new FormData(form);
      formData.append("access_key", accessKey);
      const json = JSON.stringify(Object.fromEntries(formData));

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: json,
        });

        const data = await res.json();

        if (data.success) {
          setStatus(T.ok, "ok");
          form.reset();
        } else {
          console.error("Error:", data);
          setStatus(T.err, "err");
        }
      } catch (error) {
        console.error(error);
        setStatus(T.err, "err");
      } finally {
        setBusy(false);
      }
    });
  });
</script>

<style>
  header {
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    background-color: var(--red-glow);
    width: 60%;
    color: var(--bg-field);
    padding: 0.6rem 1rem;
    border-radius: 6px 6px 0 0;
    z-index: 1;
  }
  article {
    background-color: var(--bg-base);
    /* Rojo escaso: el panel baja a --red-muted; los rojos brillantes de la vista
       quedan en el tab CONTACT_INTERFACE y en el botón ENVIAR (acción decisiva). */
    border: 2px solid var(--red-muted);
    padding: 2rem;
    width: 60%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-radius: 0 0 6px 6px;
    z-index: 1;
  }
  /* Estado del formulario (enviando / éxito / error) */
  .form-status {
    min-height: 1.4em;
    font-family: var(--font-terminal);
    font-size: 1.05rem;
    letter-spacing: 0.03em;
  }
  .form-status[data-state="sending"] { color: var(--amber-glow); }
  .form-status[data-state="ok"] {
    color: var(--cyan-glow);
    text-shadow: var(--text-glow-cyan);
  }
  .form-status[data-state="err"] {
    color: var(--red-glow);
    text-shadow: var(--text-glow-red);
  }
  article > p {
    font-family: var(--font-terminal);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }
  article p {
    color: var(--red-accent);
  }
  .network {
    text-transform: uppercase;
  }
  .username {
    font-size: 0.85rem;
  }
  .contact-info {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  .contact-info a {
    width: 30%;
    height: 150px;
    border: 1px solid var(--red-muted);
    border-radius: 5px;
    text-decoration: none;
    color: var(--red-core);

    background-color: var(--bg-raised);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }
  .contact-info a:hover {
    border: 2px solid var(--cyan-glow);
    background-color: var(--cyan-muted);
    color: var(--cyan-core);
    text-shadow: var(--text-glow-cyan);
    box-shadow: 0 0 10px var(--cyan-glow);
    scale: 1.05;
    transition: all 0.3s ease;
  }
  .contact-info a p {
    color: var(--red-core);
  }
  .contact-info a:hover p {
    color: var(--cyan-core);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .two-inputs {
    display: flex;
    gap: 1rem;
  }
</style>