---
import type { AstroComponentFactory } from 'astro/dist/runtime/server';

interface Props {
  id?: string | null | undefined;
  className?: string | null | undefined;
  text?: string;
  icon?: AstroComponentFactory;
  url?: string;
  type?: "submit" | "button" | "reset";
  width?: string;
  color?: "primary" | "secondary";
  disabled?: boolean;
}

const { id, className, text, icon: Icon, url, type = "button", width = "100%", color = "primary", disabled = false } = Astro.props;

const buttonColors = color === "secondary"
  ? {
      main: "var(--cyan-glow)",
      accent: "var(--red-glow)",
      backgroundColor: "var(--cyan-glow)",
      color: "var(--bg-base)",
    }
  : {
      main: "var(--red-glow)",
      accent: "var(--cyan-glow)",
    };
---

<button
  id={id}
  data-text={text}
  type={type}
  style={`
    width: ${width};
    --primary-color: ${buttonColors.main};
    --secondary-color: ${buttonColors.accent};
    background-color: ${buttonColors.backgroundColor};
    color: ${buttonColors.color};
    opacity: ${disabled ? 0.6 : 1};
  `}
  class={`glitch-btn ${className ?? ""} ${disabled ? 'is-disabled' : ''}`}
  disabled={disabled}
>
  {Icon && <Icon width={24} height={24} />}
  {text}
</button>

<script define:vars={{ id, url}}>
  if (url) {
    const urlLink = document.getElementById(id);
    urlLink?.addEventListener('click', () => {
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>

<style>
  .glitch-btn {
    --bg-color: var(--bg-base);
    
    --glitch-anim-duration: 0.5s;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    
    padding: 0.8em;
    background-color: transparent;
    color: var(--primary-color);
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 10px;
    position: relative;
    border: 2px solid var(--primary-color);
    transition: all 0.3s;
    overflow: hidden;
  }

  .glitch-btn:not(.is-disabled):hover,
  .glitch-btn:not(.is-disabled):focus {
    background-color: var(--primary-color);
    color: var(--bg-color);
    box-shadow: 0 0 25px var(--secondary-color);
    border: 2px solid var(--secondary-color);
    outline: none;
  }

  .glitch-btn:active {
    transform: scale(0.97);
  }

  .glitch-btn::before,
  .glitch-btn::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background-color: var(--secondary-color);
    transition: opacity 0.2s ease;
  }

  .glitch-btn:not(.is-disabled):hover::before,
  .glitch-btn:not(.is-disabled):focus::before {
    opacity: 1;
    color: var(--primary-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  .glitch-btn:not(.is-disabled):hover::after,
  .glitch-btn:not(.is-disabled):focus::after {
    opacity: 1;
    color: var(--bg-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) reverse both;
  }

  /* Disabled state: remove animations and hover effects */
  .glitch-btn.is-disabled,
  .glitch-btn:disabled {
    cursor: not-allowed;
    box-shadow: none;
    border-color: var(--primary-color);
    opacity: 0.6;
  }

  .glitch-btn.is-disabled::before,
  .glitch-btn.is-disabled::after,
  .glitch-btn:disabled::before,
  .glitch-btn:disabled::after {
    animation: none !important;
    opacity: 0 !important;
  }

  @keyframes glitch-anim {
    0% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
    20% {
      transform: translate(-5px, 3px);
      clip-path: inset(50% 0 20% 0);
    }
    40% {
      transform: translate(3px, -2px);
      clip-path: inset(20% 0 60% 0);
    }
    60% {
      transform: translate(-4px, 2px);
      clip-path: inset(80% 0 5% 0);
    }
    80% {
      transform: translate(4px, -3px);
      clip-path: inset(30% 0 45% 0);
    }
    100% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-btn:hover::before,
    .glitch-btn:focus::before,
    .glitch-btn:hover::after,
    .glitch-btn:focus::after {
      animation: none;
      opacity: 0;
    }

    .glitch-btn:hover {
      opacity: 1;
    }
  }
  @media (max-width: 600px) {
    .glitch-btn {
      font-size: min(3.5vw, 1rem);
      
    }
  }
</style>