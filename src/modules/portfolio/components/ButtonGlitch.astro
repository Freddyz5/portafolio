---
interface Props {
  id?: string | null | undefined;
  className?: string | null | undefined;
  text?: string;
  type?: "submit" | "button" | "reset";
  width?: string;
  color?: "primary" | "secondary";
}

const { id, className, text, type = "button", width = "100%", color = "primary" } = Astro.props;

const buttonColors = color === "secondary"
  ? {
      main: "var(--color-secondary-glow)",
      accent: "var(--color-glow)",
      backgroundColor: "var(--color-secondary-glow)",
      color: "var(--color-bg)",
    }
  : {
      main: "var(--color-glow)",
      accent: "var(--color-secondary-glow)",
    };
---

<button
  id={id}
  data-text={text}
  type={type}
  style={`
    width: ${width};
    --primary-color: ${buttonColors.main};
    --secondary-color: ${buttonColors.accent};
    background-color: ${buttonColors.backgroundColor};
    color: ${buttonColors.color};
  `}
  class={`glitch-btn ${className}`}
>
  {text}
</button>

<style>
  .glitch-btn {
    --bg-color: var(--color-bg);
    
    --glitch-anim-duration: 0.5s;

    width: width;
    padding: 0.8em;
    background-color: transparent;
    color: var(--primary-color);
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    /* text-transform: capitalize; */
    letter-spacing: 0.2em;
    cursor: pointer;
    border-radius: 10px;
    position: relative;
    border: 2px solid var(--primary-color);
    transition: all 0.3s;
    overflow: hidden;
  }

  .glitch-btn:hover,
  .glitch-btn:focus {
    background-color: var(--primary-color);
    color: var(--bg-color);
    box-shadow: 0 0 25px var(--secondary-color);
    border: 2px solid var(--secondary-color);
    outline: none;
  }

  .glitch-btn:active {
    transform: scale(0.97);
  }

  .glitch-btn:hover . {
    opacity: 0;
  }

  .glitch-btn::before,
  .glitch-btn::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background-color: var(--secondary-color);
    transition: opacity 0.2s ease;
  }

  .glitch-btn:hover::before,
  .glitch-btn:focus::before {
    opacity: 1;
    color: var(--primary-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  .glitch-btn:hover::after,
  .glitch-btn:focus::after {
    opacity: 1;
    color: var(--bg-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) reverse both;
  }

  @keyframes glitch-anim {
    0% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
    20% {
      transform: translate(-5px, 3px);
      clip-path: inset(50% 0 20% 0);
    }
    40% {
      transform: translate(3px, -2px);
      clip-path: inset(20% 0 60% 0);
    }
    60% {
      transform: translate(-4px, 2px);
      clip-path: inset(80% 0 5% 0);
    }
    80% {
      transform: translate(4px, -3px);
      clip-path: inset(30% 0 45% 0);
    }
    100% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-btn:hover::before,
    .glitch-btn:focus::before,
    .glitch-btn:hover::after,
    .glitch-btn:focus::after {
      animation: none;
      opacity: 0;
    }

    .glitch-btn:hover {
      opacity: 1;
    }
  }
</style>