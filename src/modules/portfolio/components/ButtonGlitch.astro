---
/**
 * ButtonGlitch — botón/enlace unificado con tres variantes.
 *
 *  - primary   (glitch): acción decisiva. Contorno rojo, texto rojo, glitch al hover.
 *  - secondary (glitch): acción decisiva alternativa. Relleno cian, texto oscuro, glitch al hover.
 *  - quiet     (sin glitch): CTA no decisiva. Transición suave, dos tonos vía `tone`:
 *        · tone="cyan"  (default) — acento de interfaz.
 *        · tone="muted"           — rojo apagado (mantiene el rojo escaso).
 *
 * Renderiza <a> si recibe `href` y no está deshabilitado; si no, <button>.
 * El glitch se reserva a la acción decisiva de cada vista; el resto usa `variant="quiet"`.
 */
import type { AstroComponentFactory } from "astro/dist/runtime/server";

interface Props {
  id?: string | null | undefined;
  className?: string | null | undefined;
  text?: string;
  icon?: AstroComponentFactory;
  href?: string;
  target?: string;
  type?: "submit" | "button" | "reset";
  width?: string;
  variant?: "primary" | "secondary" | "quiet";
  tone?: "cyan" | "muted";
  disabled?: boolean;
}

const {
  id,
  className,
  text,
  icon: Icon,
  href,
  target,
  type = "button",
  width,
  variant = "primary",
  tone = "cyan",
  disabled = false,
} = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
const resolvedWidth = width ?? (variant === "quiet" ? "auto" : "100%");
const iconSize = variant === "quiet" ? 18 : 24;

const cls = [
  "glitch-btn",
  `glitch-btn--${variant}`,
  variant === "quiet" ? `tone-${tone}` : "",
  disabled ? "is-disabled" : "",
  className ?? "",
]
  .filter(Boolean)
  .join(" ");

const styleAttr = `width:${resolvedWidth}`;
---

{
  disabled ? (
    <button
      id={id}
      type="button"
      class={cls}
      style={styleAttr}
      data-text={text}
      disabled
    >
      {Icon && <Icon width={iconSize} height={iconSize} />}
      {text}
    </button>
  ) : href ? (
    <a
      id={id}
      href={href}
      target={target}
      rel={rel}
      class={cls}
      style={styleAttr}
      data-text={text}
    >
      {Icon && <Icon width={iconSize} height={iconSize} />}
      {text}
    </a>
  ) : (
    <button id={id} type={type} class={cls} style={styleAttr} data-text={text}>
      {Icon && <Icon width={iconSize} height={iconSize} />}
      {text}
    </button>
  )
}

<style>
  /* Base común a todas las variantes */
  .glitch-btn {
    --bg-color: var(--bg-base);
    --glitch-anim-duration: 0.5s;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    cursor: pointer;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
  }

  .glitch-btn:not(.is-disabled):active {
    transform: scale(0.97);
  }

  /* ---- Variantes con glitch (primary / secondary) ---- */
  .glitch-btn--primary,
  .glitch-btn--secondary {
    padding: 0.8em;
    font-weight: 700;
    background-color: transparent;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
  }

  .glitch-btn--primary {
    --primary-color: var(--red-glow);
    --secondary-color: var(--cyan-glow);
  }

  .glitch-btn--secondary {
    --primary-color: var(--cyan-glow);
    --secondary-color: var(--red-glow);
    background-color: var(--primary-color);
    color: var(--bg-color);
  }

  .glitch-btn--primary:not(.is-disabled):hover,
  .glitch-btn--primary:not(.is-disabled):focus,
  .glitch-btn--secondary:not(.is-disabled):hover,
  .glitch-btn--secondary:not(.is-disabled):focus {
    background-color: var(--primary-color);
    color: var(--bg-color);
    box-shadow: 0 0 25px var(--secondary-color);
    border-color: var(--secondary-color);
    outline: none;
  }

  /* Capa glitch (solo variantes con glitch) */
  .glitch-btn--primary::before,
  .glitch-btn--primary::after,
  .glitch-btn--secondary::before,
  .glitch-btn--secondary::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background-color: var(--secondary-color);
    transition: opacity 0.2s ease;
  }

  .glitch-btn--primary:not(.is-disabled):hover::before,
  .glitch-btn--primary:not(.is-disabled):focus::before,
  .glitch-btn--secondary:not(.is-disabled):hover::before,
  .glitch-btn--secondary:not(.is-disabled):focus::before {
    opacity: 1;
    color: var(--primary-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  .glitch-btn--primary:not(.is-disabled):hover::after,
  .glitch-btn--primary:not(.is-disabled):focus::after,
  .glitch-btn--secondary:not(.is-disabled):hover::after,
  .glitch-btn--secondary:not(.is-disabled):focus::after {
    opacity: 1;
    color: var(--bg-color);
    animation: glitch-anim var(--glitch-anim-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) reverse both;
  }

  /* ---- Variante quiet (sin glitch) ---- */
  .glitch-btn--quiet {
    padding: 0.8em 1.4em;
    font-weight: 500;
    text-transform: uppercase;
    background-color: transparent;
    border: 1px solid transparent;
    transition: background-color 0.25s ease, border-color 0.25s ease,
      box-shadow 0.25s ease, color 0.25s ease;
  }

  /* Tono cian (interfaz) */
  .glitch-btn--quiet.tone-cyan {
    color: var(--cyan-glow);
    border-color: var(--cyan-accent);
  }
  .glitch-btn--quiet.tone-cyan:not(.is-disabled):hover,
  .glitch-btn--quiet.tone-cyan:not(.is-disabled):focus-visible {
    background-color: color-mix(in srgb, var(--cyan-glow) 8%, transparent);
    border-color: var(--cyan-glow);
    box-shadow: 0 0 12px color-mix(in srgb, var(--cyan-glow) 30%, transparent);
  }

  /* Tono muted (rojo apagado, sin bloom → respeta el rojo escaso) */
  .glitch-btn--quiet.tone-muted {
    color: var(--red-core);
    border-color: var(--red-muted);
  }
  .glitch-btn--quiet.tone-muted:not(.is-disabled):hover,
  .glitch-btn--quiet.tone-muted:not(.is-disabled):focus-visible {
    background-color: color-mix(in srgb, var(--red-glow) 8%, transparent);
    border-color: var(--red-accent);
  }

  /* ---- Estado deshabilitado ---- */
  .glitch-btn.is-disabled,
  .glitch-btn:disabled {
    cursor: not-allowed;
  }
  .glitch-btn--primary.is-disabled,
  .glitch-btn--secondary.is-disabled,
  .glitch-btn--primary:disabled,
  .glitch-btn--secondary:disabled {
    box-shadow: none;
    border-color: var(--primary-color);
    opacity: 0.6;
  }
  .glitch-btn--quiet.is-disabled,
  .glitch-btn--quiet:disabled {
    opacity: 0.45;
  }
  .glitch-btn.is-disabled::before,
  .glitch-btn.is-disabled::after,
  .glitch-btn:disabled::before,
  .glitch-btn:disabled::after {
    animation: none !important;
    opacity: 0 !important;
  }

  @keyframes glitch-anim {
    0% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
    20% {
      transform: translate(-5px, 3px);
      clip-path: inset(50% 0 20% 0);
    }
    40% {
      transform: translate(3px, -2px);
      clip-path: inset(20% 0 60% 0);
    }
    60% {
      transform: translate(-4px, 2px);
      clip-path: inset(80% 0 5% 0);
    }
    80% {
      transform: translate(4px, -3px);
      clip-path: inset(30% 0 45% 0);
    }
    100% {
      transform: translate(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-btn:hover::before,
    .glitch-btn:focus::before,
    .glitch-btn:hover::after,
    .glitch-btn:focus::after {
      animation: none;
      opacity: 0;
    }

    .glitch-btn:hover {
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .glitch-btn--quiet {
      width: 100% !important;
    }
  }
  @media (max-width: 600px) {
    .glitch-btn {
      font-size: min(3.5vw, 1rem);
    }
  }
</style>
