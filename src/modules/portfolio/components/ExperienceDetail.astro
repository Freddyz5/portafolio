---
import SquareChevronRight from 'src/shared/icons/SquareChevronRight.astro';
import Chip from './Chip.astro';
import { highlightText } from 'src/shared/utils/highlightText';

interface Team {
  teamId: string;
  teamName: string;
  role: string;
  startDate?: string;
  endDate?: string | null;
  stack: string[];
  summary: string;
  highlights?: unknown[];
}

interface Work {
  name: string;
  position: string;
  teams?: Team[];
}

interface Props {
  lang: string;
  works: Work[];
}

const { lang, works } = Astro.props;

const ym = (d?: string | null) => (d ? d.slice(0, 7) : "");
const presentLabel = lang === "es" ? "Presente" : "Present";

const teamEntries = (works ?? []).flatMap((w) =>
  (w.teams ?? []).map((t) => ({ team: t, work: w }))
);
---

<dialog id="team-detail-dialog" class="team-dialog" aria-modal="true">
  <div class="team-dialog-viewport">
    <header class="team-dialog-head">
      <SquareChevronRight width={20} height={20} />
      <span class="team-dialog-head-label">
        {lang === "es" ? "REGISTRO_DE_EQUIPO" : "TEAM_RECORD"}
      </span>
      <button type="button" id="team-detail-close" class="detail-close-btn">
        {lang === "es" ? "✕ Cerrar" : "✕ Close"}
      </button>
    </header>

    <div class="team-dialog-body">
      {teamEntries.map(({ team: t, work: w }) => {
        const stack = t.stack ?? [];
        const highlights = t.highlights ?? [];
        const titleId = `team-detail-title-${t.teamId}`;
        return (
          <article class="team-detail-panel" data-team-id={t.teamId} style="display: none;">
            <header class="team-detail-panel-head">
              <h3 id={titleId}>{"▸ "}{t.teamName}</h3>
              <p class="team-detail-context">{w.position} · {w.name}</p>
            </header>

            <div class="team-detail-meta">
              <span class="team-detail-role">{t.role}</span>
              <span class="team-detail-date">
                {ym(t.startDate)} ➜ {t.endDate ? ym(t.endDate) : presentLabel}
              </span>
            </div>

            {t.summary && <p class="team-detail-summary">{t.summary}</p>}

            {stack.length > 0 && (
              <div class="team-detail-section">
                <h4>{lang === "es" ? "> STACK_COMPLETO" : "> FULL_STACK"}</h4>
                <div class="stack-tags">
                  {stack.map((s: string) => <Chip text={s} color="var(--cyan-accent)" />)}
                </div>
              </div>
            )}

            {highlights.length > 0 && (
              <div class="team-detail-section">
                <h4>{lang === "es" ? "> LOGROS" : "> HIGHLIGHTS"}</h4>
                <ul class="highlights">
                  {highlights.map((h: unknown) => <li>{highlightText(h)}</li>)}
                </ul>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</dialog>

<style>
  dialog#team-detail-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(92vw, 720px);
    max-height: min(88vh, 820px);
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    overscroll-behavior: contain;
  }
  dialog#team-detail-dialog::backdrop {
    background: color-mix(in srgb, var(--bg-field) 80%, transparent);
    backdrop-filter: blur(2px);
  }
  .team-dialog-viewport {
    display: flex;
    flex-direction: column;
    max-height: min(88vh, 820px);
    background-color: var(--bg-base);
    border: 3px solid var(--red-glow);
    border-radius: 6px;
    overflow: hidden;
  }
  .team-dialog-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--red-glow);
    color: var(--bg-field);
    padding: 0.6rem 1rem;
  }
  .team-dialog-head-label {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    flex: 1;
  }
  .team-dialog-body {
    overflow-y: auto;
    padding: 1.5rem 1.75rem;
  }
  .team-detail-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .team-detail-panel-head h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    letter-spacing: 0.04em;
    color: var(--red-core);
  }
  .team-detail-context {
    font-family: var(--font-terminal);
    font-size: 1rem;
    letter-spacing: 0.03em;
    color: var(--red-muted);
    margin-top: 0.2rem;
  }
  .team-detail-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--fs-meta);
    color: var(--cyan-accent);
  }
  .team-detail-date {
    font-family: var(--font-terminal);
    letter-spacing: 0.04em;
  }
  .team-detail-summary {
    color: var(--cyan-core);
    line-height: 1.6;
  }
  .team-detail-section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .team-detail-section h4 {
    font-family: var(--font-terminal);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--red-accent);
  }
  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .highlights {
    list-style-type: "▸ ";
    padding-left: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--red-core) 90%, transparent);
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    dialog#team-detail-dialog {
      width: 100%;
      max-width: 100%;
      max-height: 100dvh;
      height: 100dvh;
    }
    .team-dialog-viewport {
      max-height: 100dvh;
      height: 100%;
      border-radius: 0;
      border-width: 2px;
    }
    .team-dialog-body { padding: 1.25rem; }
  }
</style>

<script>
  const dialog = document.getElementById("team-detail-dialog") as HTMLDialogElement | null;
  const viewport = dialog?.querySelector<HTMLElement>(".team-dialog-viewport");
  const closeBtn = document.getElementById("team-detail-close");
  const panels = dialog ? Array.from(dialog.querySelectorAll<HTMLElement>(".team-detail-panel")) : [];

  if (dialog && viewport) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    function withTransition(update: () => void) {
      if (!document.startViewTransition || prefersReducedMotion.matches) {
        update();
        return;
      }
      // Salvavidas: en ciertas condiciones (ej. si se llegó por la view
      // transition nativa entre documentos de Proyectos poco antes) Chromium
      // puede dejar startViewTransition colgado sin correr el callback ni
      // resolver/rechazar sus promesas. El contenido nunca debe depender de
      // que la animación llegue a correr.
      let applied = false;
      const applyOnce = () => {
        if (applied) return;
        applied = true;
        update();
      };
      document.startViewTransition(applyOnce);
      window.setTimeout(applyOnce, 800);
    }

    let lastTrigger: HTMLElement | null = null;

    function openTeam(teamEl: HTMLElement) {
      const teamId = teamEl.dataset.teamId;
      const panel = panels.find((p) => p.dataset.teamId === teamId);
      if (!dialog || !viewport || !panel) return;

      lastTrigger = teamEl;
      const vtName = `team-detail-${teamId}`;

      // Se asigna ANTES de abrir la transición para que el snapshot "old" la capture.
      teamEl.style.setProperty("view-transition-name", vtName);
      teamEl.style.setProperty("view-transition-class", "team-morph");

      withTransition(() => {
        panels.forEach((p) => { p.style.display = "none"; });
        panel.style.display = "flex";
        dialog.setAttribute("aria-labelledby", panel.querySelector("h3")?.id ?? "");

        // El dialog toma el nombre para el estado "new"; la card lo suelta.
        viewport.style.setProperty("view-transition-name", vtName);
        viewport.style.setProperty("view-transition-class", "team-morph");
        teamEl.style.removeProperty("view-transition-name");
        teamEl.style.removeProperty("view-transition-class");

        dialog.showModal();
      });
    }

    function closeTeam() {
      if (!dialog || !viewport) return;
      const teamEl = lastTrigger;

      withTransition(() => {
        if (teamEl) {
          const teamId = teamEl.dataset.teamId;
          teamEl.style.setProperty("view-transition-name", `team-detail-${teamId}`);
          teamEl.style.setProperty("view-transition-class", "team-morph");
        }
        viewport.style.removeProperty("view-transition-name");
        viewport.style.removeProperty("view-transition-class");
        dialog.close();
      });
    }

    dialog.addEventListener("close", () => {
      if (lastTrigger) {
        lastTrigger.style.removeProperty("view-transition-name");
        lastTrigger.style.removeProperty("view-transition-class");
        lastTrigger.focus();
      }
      lastTrigger = null;
    });

    // Esc dispara `cancel` antes de cerrar: lo interceptamos para que también
    // dispare el morph de regreso en vez de un cierre seco.
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeTeam();
    });

    // Click en el backdrop del <dialog> (target === dialog, no un descendiente).
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeTeam();
    });

    closeBtn?.addEventListener("click", () => closeTeam());

    document.querySelectorAll<HTMLElement>(".team").forEach((teamEl) => {
      teamEl.addEventListener("click", () => openTeam(teamEl));
      teamEl.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
          e.preventDefault();
          openTeam(teamEl);
        }
      });
    });
  }
</script>
