---
import Logo from "./AnimatedLogo.astro";
import ButtonGlitch from "./ButtonGlitch.astro";

interface Props {
  lang: "es" | "en";
	name: string;
	label: string;
}

const { lang, name, label } = Astro.props;
---

<section class="home" id="home">
	<Logo />
	<article>
		<h1>{name.toLocaleUpperCase()}</h1>
		<h2>{"> "}{ label}</h2>
		<div class="button-container">
			<ButtonGlitch
				id="projects-button"
				text={lang === "es" ? "Ver proyectos >" : "View projects >"}
				width="50%"
				color="secondary"
			/>
			<ButtonGlitch
				id="contact-button"
				text={lang === "es" ? "Iniciar el contacto" : "Start contact"}
				width="50%"
			/>
		</div>
	</article>
</section>

<script>
	const contactButton = document.getElementById("contact-button");
	contactButton?.addEventListener("click", () => {
		const contactSection = document.getElementById("contact");
		contactSection?.scrollIntoView({ behavior: "smooth" });
	});
	
	const projectsButton = document.getElementById("projects-button");
	projectsButton?.addEventListener("click", () => {
		const projectsSection = document.getElementById("projects");
		projectsSection?.scrollIntoView({ behavior: "smooth" });
	});
</script>

<style>
	.home {
		width: 100%;
		height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		scroll-margin-top: 5em;
	}
	article {
		width: 80vw;
		max-width: 550px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;

		margin-top: -10rem;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: var(--fw-display);
		font-size: clamp(1.5em, 8vw, 2.5em);
		color: var(--red-glow);
		text-shadow: 0 0 15px var(--red-glow);
	}
	h2 {
		font-size: clamp(0.5em, 4vw, 1.25em);
		font-weight: 400;
		margin-bottom: 1.5em;
		color: var(--red-core);
	}
	.button-container {
		display: flex;
		flex-direction: row;
		gap: 1em;
		width: 100%;
	}
	@media (width <= 900px) {
		.home {
			flex-direction: column;
		}
	}
</style>
