---
interface Props {
  currentLang: 'es' | 'en' | string;
}

const { currentLang } = Astro.props;
const otherLang = currentLang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname.replace(new RegExp(`/${currentLang}(/|$)`), `/${otherLang}$1`);
---

<a href={currentPath} class="nav-link"  >
  <span class={currentLang === 'es' ? ' en' : 'lang-selected'}>en</span>
  /
  <span class={currentLang === 'en' ? ' es' : 'lang-selected'}>es</span>
</a>

<style>
  .nav-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    color: var(--cyan-accent);
    font-family: var(--font-body);
		font-size: var(--fs-meta);
    padding: 0.2em 0.6em;
		border-radius: 0.2em;
    transition: 300ms;
    cursor: pointer;
    /* text-transform: lowercase; */
  }
  .nav-link:hover{
    color: var(--cyan-glow);
		text-shadow: var(--text-glow-cyan);
    scale: 1.05;
  }
  .lang-selected {
    color: var(--red-glow);
		text-shadow: var(--text-glow-red);
  }
</style>