---
import MenuIcon from "src/shared/icons/Menu.astro";
import Translate from "./Translate.astro";
import { LINKS } from "../constants/links";
import type { Link } from "../constants/links";

interface Props {
	lang: 'es' | 'en' | string;
	links?: Link[];
}

const { lang, links } = Astro.props;

const homeLink = links ? links.find((link) => link.id === "home") : LINKS.find((link) => link.id === "home");
const menuLinks = links ? links.filter((link) => !link.isIcon) : LINKS.filter((link) => !link.isIcon);
---

<nav id="navbar">
	<section class="home-container">
		<a id=`nav-${homeLink?.id}` href={homeLink?.href} class="home-link">
			<span class="nav-mark" aria-hidden="true">◈</span>
			<h1>FR-3D • sistema nominal</h1>
		</a>
	</section>

	<!-- <div class="hero-status">
		<span class="hero-status__left">
			<span class="chev">&gt;</span>
			<b class="glow-cyan">FR-3D</b>
			<span class="sys">· {sysLabel}</span>
		</span>
		<span class="hero-status__right">
			<time class="hero-clock glow-amber">T+00:00:00</time>
			<span class="rec">{recLabel}</span>
		</span>
	</div> -->

	<section class="link-container">
		<a id="menu" href="#menu-list" class="menu nav-link" aria-label="Menu">
			<MenuIcon />
			<h1>Freddy</h1>
		</a>

		<div id="menu-list" class="menu-list">
			{
				menuLinks.map((link: Link) => (
					<a
						id={`nav-${link.id}`}
						class="nav-link"
						href={link.href}
						data-section="nav-bar"
						data-value={link.name}
					>
						{link.name instanceof Object ? (lang === 'es' ? link.name.es : link.name.en) : link.name}
					</a>
				))
			}

			<Translate currentLang={lang} />
		</div>
	</section>
</nav>

<script>
	import { LINKS } from "../constants/links";

	document.addEventListener("DOMContentLoaded", () => {
		const navlinks = document.querySelectorAll("nav a");
		const navbar = document.getElementById("navbar");

		const sections = LINKS.map((link) => {
			return {
				name: link.id,
				element: document.getElementById(`${link.id}`),
			};
		});

		window.addEventListener("load", () => {
			navlinks.forEach((link) => {
				link.children[1]?.classList.add("name-off");
			});
		});

		window.addEventListener("scroll", () => {
			let currentSection = "";
			let sectionTop = 0;
			let sectionBottom = 0;

			sections.map((section) => {
				sectionTop = section.element!.offsetTop - navbar!.offsetHeight;
				sectionBottom = sectionTop + section.element!.offsetHeight;

				if (window.scrollY >= sectionTop && window.scrollY < sectionBottom) {
					currentSection = section.name;
				}
			});

			navlinks.forEach((link) => {
				link.classList.remove("active");

				link.children[1] ? link.children[1].classList.remove("name-off") : "";

				if (link.getAttribute("href")!.substring(1) === currentSection) {
					link.getAttribute("href")!.substring(1) === "home"
						? link.children[1].classList.add("name-off")
						: link.classList.add("active");
				}
			});
		});
	});
</script>

<style>
	#navbar {
		background-color: color-mix(in srgb, var(--bg-base) 90%, transparent);
		backdrop-filter: blur(10px);
		position: sticky;
		bottom: 0px;
		left: 0px;
		right: 0px;
		width: 100%;
		height: 40px;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 0 1.25rem;
		gap: 0.5em;
		white-space: nowrap;
		border-bottom: 1px solid color-mix(in srgb, var(--red-muted) 45%, transparent);
		z-index: 3;

		view-timeline-name: --navbar;
		view-timeline-axis: block;

		animation-timeline: --navbar;
		animation-name: show;

		animation-range: entry 0% cover 30%;
		animation-fill-mode: both;
	}
	.home-container {
		width: 100%;
	}
	/* ===== Marca ◈ HLCS ===== */
	.home-link {
		width: fit-content;
		display: flex;
		align-items: center;
		text-decoration: none;
		gap: 0.6em;
	}
	.nav-mark {
		font-family: var(--font-display);
		font-size: 1.25rem;
		line-height: 1;
		color: var(--red-glow);
		filter: drop-shadow(0 0 0.4rem var(--red-accent));
		transition: 0.3s;
	}
	.home-link h1 {
		font-family: var(--font-terminal);
		color: var(--cyan-accent);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		transition: 0.3s;
	}
	.cmd-console__cursor {
    width: 0.5em;
    height: 1em;
    background-color: var(--amber-glow);
    box-shadow: var(--text-glow-amber);
    animation: cmd-console-blink 1.1s step-end infinite;
  }
	@keyframes cmd-console-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
	.home-link:hover .nav-mark {
		color: var(--cyan-glow);
		filter: drop-shadow(0 0 0.5rem var(--cyan-accent));
		transform: rotate(45deg);
		transition: 0.3s;
	}
	.home-link:hover h1 {
		color: var(--cyan-glow);
		text-shadow: var(--text-glow-cyan);
	}

	/* ===== Enlaces de navegación (texto discreto, no cajas) ===== */
	.menu {
		display: none;
	}
	.menu-list {
		width: 100%;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
		align-items: center;
		gap: 1.25rem;
	}
	.nav-link {
		font-family: var(--font-body);
		font-size: var(--fs-meta);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cyan-accent);
		text-decoration: none;
		padding: 0.35em 1em;
		border: 1px solid transparent;
		border-radius: 0.2em;
		transition: 300ms;
	}
	.nav-link:hover {
		color: var(--red-glow);
		text-shadow: var(--text-glow-red);
		border: 1px solid var(--red-glow);
	}
	/* .name-off {
		opacity: 0;
		transition: 0.3s;
	} */
	.active {
		color: var(--red-glow);
		text-shadow: var(--text-glow-red);
		border: 1px solid var(--red-glow);
		border-top: 3px solid var(--red-glow);
	}

	@keyframes show {
		70% {
			top: 0px;
			width: 100%;
		}
		100% {
			top: 1px;
			width: 99.5%;
			border-radius: 0.1em;
		}
	}
	@media (700px >= width >= 0px) {
		#navbar {
			backdrop-filter: none;
		}
		.link-container {
			height: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: end;
		}
		.menu {
			display: flex;
			align-items: center;
			gap: 0.4em;
			color: var(--red-core);
		}
		.menu h1 {
			font-family: var(--font-display);
			font-size: 1.1rem;
			font-weight: 500;
			color: var(--red-core);
		}
		.menu-list {
			background-color: color-mix(in srgb, var(--bg-base) 92%, transparent);
			backdrop-filter: blur(10px);
			width: fit-content;
			display: none;
			flex-direction: column;
			align-items: flex-end;
			position: absolute;
			top: 110%;
			right: 1%;
			padding: 0.8em 1em;
			gap: 0.9em;
			border: 1px solid color-mix(in srgb, var(--red-muted) 60%, transparent);
			border-radius: 0.5em;
		}
		.menu-list:target {
			display: flex;
		}
	}
</style>
