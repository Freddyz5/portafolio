---
import Logo from "src/shared/icons/Logo.astro";

interface Props {
	lang: 'es' | 'en' | string;
}

const { lang } = Astro.props;
---

<footer>
	<figure>
		<p>Freddy</p>
		<Logo class="logo-footer"/>
		<p>Tacuri</p>
	</figure>
	<p>
		Copyright © 2025 Freddy Tacuri -
		<p
			data-section="footer"
			data-value="title"
		>
			{lang === 'es' ? 'Con la ayuda e inspirado por,' : 'With the help and inspired by,'}
		</p>
		<a
			href="https://www.youtube.com/c/midudev?sub_confirmation=1"
			target="_blank"
		>
			Midudev
		</a>
	</p>
</footer>

<style>
	footer {
		/* margin-top: -100px; */
		padding-top: 1.8em;
		padding-bottom: 1em;
		text-align: center;
		align-items: center;
		position: relative;
		font-size: 13px;
		background-image:
			radial-gradient(
				circle at center center,
				transparent 0%,
				rgba(255, 255, 255, 0) 99%
			),
			repeating-linear-gradient(
				0deg,
				color-mix(in srgb, var(--color-muted) 25%, transparent) 0px,
				color-mix(in srgb, var(--color-muted) 25%, transparent) 1px,
				transparent 1px,
				transparent 10px
			),
			repeating-linear-gradient(
				90deg,
				color-mix(in srgb, var(--color-muted) 25%, transparent) 0px,
				color-mix(in srgb, var(--color-muted) 25%, transparent) 1px,
				transparent 1px,
				transparent 10px
			),
			linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0));
	}
	footer::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(to top, transparent 30%, var(--color-bg-darker) 100%);
	}
	figure {
		align-items: center;
		justify-content: center;
		gap: 1em;
		margin: 0.5em;
	}
	svg {
		width: 25px;
		height: 25px;
		stroke: var(--color-text);
		color: var(--color-text);
		stroke-width: 5px;
	}
	.logo-footer {
		z-index: 2;
		transition: 0.3s ease;
	}
	.logo-footer:hover {
		stroke: var(--color-secondary-glow);
		color: var(--color-secondary-glow);
		filter: drop-shadow(0 0 0.5rem var(--color-secondary-accent));
		transform: rotate(30deg);
		scale: 1.1;
		transition: 0.3s ease;
	}
	p {
		display: inline;
	}
	a {
		position: relative;
		color: var(--color-text);
		z-index: 5;
	}
</style>
