---
import Logo from "src/shared/icons/Logo.astro";

interface Props {
	lang: 'es' | 'en' | string;
}

const { lang } = Astro.props;

// Enlace discreto al sistema de diseño (contenido secundario: solo footer, nunca nav).
const designSystemHref = `${import.meta.env.BASE_URL}/${lang === 'es' ? 'es' : 'en'}/sistema-de-diseno`;
const designSystemLabel = lang === 'es' ? 'Sistema de diseño' : 'Design system';
---

<footer>
	<figure>
		<p>Freddy</p>
		<Logo class="logo-footer"/>
		<p>Tacuri</p>
	</figure>
	<p>
		Copyright © 2025 Freddy Tacuri -
		<p
			data-section="footer"
			data-value="title"
		>
			{lang === 'es' ? 'Con la ayuda e inspirado por,' : 'With the help and inspired by,'}
		</p>
		<a
			href="https://www.youtube.com/c/midudev?sub_confirmation=1"
			target="_blank"
		>
			Midudev
		</a>
	</p>
	<p class="footer-secondary">
		<a href={designSystemHref} class="design-system-link">{designSystemLabel}</a>
	</p>
</footer>

<style>
	footer {
		padding-top: 1.8em;
		padding-bottom: 1em;
		text-align: center;
		align-items: center;
		position: relative;
		font-size: 13px;
		background-image:
			radial-gradient(
				circle at center center,
				transparent 0%,
				var(--white-transparent) 99%
			),
			repeating-linear-gradient(
				0deg,
				color-mix(in srgb, var(--red-muted) 25%, transparent) 0px,
				color-mix(in srgb, var(--red-muted) 25%, transparent) 1px,
				transparent 1px,
				transparent 10px
			),
			repeating-linear-gradient(
				90deg,
				color-mix(in srgb, var(--red-muted) 25%, transparent) 0px,
				color-mix(in srgb, var(--red-muted) 25%, transparent) 1px,
				transparent 1px,
				transparent 10px
			),
			linear-gradient(90deg, var(--white-transparent), var(--white-transparent));
	}
	footer::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(to top, transparent 30%, var(--bg-field) 100%);
	}
	figure {
		align-items: center;
		justify-content: center;
		gap: 1em;
		margin: 0.5em;
	}
	svg {
		width: 25px;
		height: 25px;
		stroke: var(--red-core);
		color: var(--red-core);
		stroke-width: 5px;
	}
	.logo-footer {
		z-index: 2;
		transition: 0.3s ease;
	}
	.logo-footer:hover {
		stroke: var(--cyan-glow);
		color: var(--cyan-glow);
		filter: drop-shadow(0 0 0.5rem var(--cyan-accent));
		transform: rotate(30deg);
		scale: 1.1;
		transition: 0.3s ease;
	}
	p {
		display: inline;
	}
	a {
		position: relative;
		color: var(--red-core);
		z-index: 5;
		transition: 0.3s ease;
	}
	a:hover {
		color: var(--cyan-glow);
		text-shadow: var(--text-glow-cyan);
	}
	.footer-secondary {
		display: block;
		margin-top: 0.6em;
		font-size: var(--fs-meta);
	}
	.design-system-link {
		color: color-mix(in srgb, var(--red-core) 55%, transparent);
		letter-spacing: 0.05em;
	}
</style>
