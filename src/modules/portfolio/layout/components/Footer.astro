---
import Logo from "src/shared/icons/Logo.astro";
---

<footer>
	<figure>
		<p>Freddy</p>
		<Logo />
		<p>Tacuri</p>
	</figure>
	<p>
		Copyright © 2025 Freddy Tacuri -
		<p
			data-section="footer"
			data-value="title"
		>
			Con la ayuda e inspirado por,
		</p>
		<a
			href="https://www.youtube.com/c/midudev?sub_confirmation=1"
			target="_blank"
		>
			Midudev
		</a>
	</p>
</footer>

<style>
	footer {
		margin-top: -100px;
		padding-top: 1.8em;
		padding-bottom: 1em;
		text-align: center;
		align-items: center;
		position: relative;
		font-size: 13px;
		background-image:
			radial-gradient(
				circle at center center,
				transparent 0%,
				rgba(255, 255, 255, 0) 99%
			),
			repeating-linear-gradient(
				0deg,
				rgba(205, 205, 205, 0.2) 0px,
				rgba(205, 205, 205, 0.2) 1px,
				transparent 1px,
				transparent 10px
			),
			repeating-linear-gradient(
				90deg,
				rgba(205, 205, 205, 0.2) 0px,
				rgba(205, 205, 205, 0.2) 1px,
				transparent 1px,
				transparent 10px
			),
			linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0));
	}
	footer::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(to top, transparent 30%, #141414 100%);
	}
	figure {
		align-items: center;
		justify-content: center;
		gap: 1em;
		margin: 0.5em;
	}
	svg {
		width: 25px;
		height: 25px;
		stroke: #fff7ed;
		color: #fff7ed;
		stroke-width: 5px;
	}
	p {
		display: inline;
	}
	a {
		position: relative;
		color: #fff7ed;
		z-index: 5;
	}
</style>
