---
import ProjectsComponent from './components/Projects.astro';
import ProjectsDetail from './components/ProjectsDetail.astro';

interface Props {
  data: any;
}

const lang = Astro.url.pathname.includes("/es/") ? "es" : "en";

const { data } = Astro.props;
const { projects } = data;
---

<main>
  <ProjectsComponent
    lang={lang}
    projects={projects}
    showStatus={true}
    title={lang === "es" ? "Todos los proyectos" : "All Projects"}
    subTittle={lang === "es" ? "ARCHIVO_COMPLETO • REGISTRO_DE_MISIONES" : "FULL_ARCHIVE • MISSION_LOG"}
  />
  <ProjectsDetail lang={lang} projects={projects} />
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const projectsList = document.getElementById('projects') as HTMLElement;
    const projectDetail = document.getElementById('project-detail') as HTMLElement;
    const projectCards = document.querySelectorAll('.project-detail-card');

    // Función para obtener el ID del query param
    function getProjectIdFromURL() {
      const params = new URLSearchParams(window.location.search);
      return params.get('id');
    }

    // El ir/volver aquí no cambia de documento, así que la view transition
    // nativa no aplica: hay que pedirla a mano para que el morph sea simétrico.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    function withTransition(update: () => void) {
      if (!document.startViewTransition || prefersReducedMotion.matches) {
        update();
        return;
      }
      // Salvavidas: si esta página llegó por la view transition nativa entre
      // documentos (click en una card), Chromium a veces deja startViewTransition
      // colgado —ni corre el callback ni resuelve/rechaza sus promesas— cuando se
      // pide una segunda transition (misma página) poco después. El cambio de
      // contenido nunca debe depender de que la animación llegue a correr.
      let applied = false;
      const applyOnce = () => {
        if (applied) return;
        applied = true;
        update();
      };
      document.startViewTransition(applyOnce);
      window.setTimeout(applyOnce, 800);
    }

    // Función para mostrar todos los proyectos
    function showAllProjects() {
      projectsList.style.display = 'block';
      projectDetail.style.display = 'none';

      // Ocultar todas las tarjetas de detalle
      projectCards.forEach((card: any) => {
        card.style.display = 'none';
      });
    }

    // Quita el ?id= conservando base y lang (antes se reconstruía la ruta a
    // mano y se perdía el prefijo /portafolio).
    function clearProjectIdFromURL() {
      window.history.pushState({}, '', window.location.pathname);
    }

    // Función para mostrar un proyecto específico
    function showProjectDetail(projectId: string) {
      // Buscar la tarjeta del proyecto
      const projectCard = document.querySelector(`.project-detail-card[data-project-id="${projectId}"]`) as HTMLElement;
      
      if (!projectCard) {
        showAllProjects();
        return;
      }

      // Ocultar todas las tarjetas primero
      projectCards.forEach((card: any) => {
        card.style.display = 'none';
      });

      // Ocultar lista y mostrar detalle
      projectsList.style.display = 'none';
      projectDetail.style.display = 'flex';
      projectCard.style.display = 'block';
    }

    // Manejar el botón de cerrar/volver — delegado en la sección porque hay uno
    // por project-detail-card (mismo botón .detail-close-btn que usa el dialog
    // de Experiencia), no un solo id fijo.
    projectDetail.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.detail-close-btn')) return;
      e.preventDefault();
      clearProjectIdFromURL();
      withTransition(showAllProjects);
    });

    // Verificar si hay un ID en la URL al cargar. Sin envolver: en la carga
    // inicial manda la transición entre documentos, y este cambio de display
    // debe estar hecho antes del primer render para que el morph enganche.
    const projectId = getProjectIdFromURL();
    if (projectId) {
      showProjectDetail(projectId);
    }

    // Manejar navegación del navegador (botones atrás/adelante)
    window.addEventListener('popstate', () => {
      const projectId = getProjectIdFromURL();
      withTransition(() => {
        if (projectId) {
          showProjectDetail(projectId);
        } else {
          showAllProjects();
        }
      });
    });
  });
</script>

