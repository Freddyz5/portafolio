---
import { UI_LABELS } from '../constants/UI_LABELS';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const ui = UI_LABELS[lang];
---

<div class="view-toggle" role="group">
  <button id="view-cv" type="button" class="active">{ui.viewCv}</button>
  <button id="view-ats" type="button">{ui.viewAts}</button>
</div>

<style>
  .view-toggle {
    display: flex;
    gap: 0;
  }

  .view-toggle button {
    flex: 1;
    padding: 7px 10px;
    font-size: 13px;
    cursor: pointer;
    border: 1px solid #111;
    background: #fff;
    color: #111;
  }

  .view-toggle button.active {
    background: #111;
    color: #fff;
  }

  .view-toggle button.active:hover,
  .view-toggle button:hover {
    scale: 1.02;
    box-shadow: 2px 2px 0px 0px #555;
  }
</style>
