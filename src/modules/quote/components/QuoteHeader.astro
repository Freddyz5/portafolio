---
/* Cabecera del cotizador: salida a la landing y el mismo interruptor de tema. */
import ThemeToggle from '../../../shared/components/ThemeToggle.astro';

interface Props {
  back: string;
  backHref: string;
  themeAria: string;
  themeDark: string;
  themeLight: string;
}

const { back, backHref, themeAria, themeDark, themeLight } = Astro.props;
---

<header class="cl-header">
  <a class="cl-back" href={backHref}>
    <span aria-hidden="true">&#8592;</span>
    <span>{back}</span>
  </a>

  <ThemeToggle ariaLabel={themeAria} darkLabel={themeDark} lightLabel={themeLight} />
</header>

<style>
  .cl-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--cl-bg);
    border-bottom: var(--cl-rule) solid var(--cl-divider);
    transition: background-color 0.3s ease;
  }

  .cl-back {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px var(--cl-pad);
    color: var(--cl-muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cl-back:hover {
    color: var(--cl-ink);
  }
</style>
