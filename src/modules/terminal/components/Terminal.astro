---
/*
  Terminal FR-3D — barra de comandos con filesystem virtual. Capa OPCIONAL de
  mejora progresiva (sustituye a CommandBar.astro).

  Contrato de la barra acoplada:
  - Sin JS no aparece (atributo `hidden`); el sitio navega con scroll/click/teclado.
  - Ninguna información real es exclusiva de la terminal: todo destino de `open`
    está también en el nav, el footer y los botones. Solo el sabor (motd, VFS,
    easter eggs) es exclusivo.
  - No captura el foco por defecto ni interfiere con el scroll. Se enfoca con `/`
    o `` ` `` (o click) y se sale con `Esc`. Sin focus trap.
  - Jerarquía de `Esc` (3 niveles): tarea en curso → aborta la tarea; pantalla
    completa → vuelve a acoplado; acoplado y enfocado → desenfoca el input.
  - Tareas asíncronas (comandos con salida progresiva, p. ej. `install`): corren
    contra un TerminalSink que reescribe líneas en vivo. Mientras una corre, el
    input queda `disabled` (una tarea a la vez) y Ctrl+C / Esc la abortan.
  - EXCEPCIÓN — pantalla completa (Ctrl+` o comando `fullscreen`): la terminal
    cubre el viewport y SÍ se comporta como modal (<dialog> + showModal: role
    dialog, aria-modal, focus trap, foco devuelto al salir). Es la conducta
    correcta para un overlay a pantalla completa y la invoca el usuario a
    propósito, a diferencia de la barra acoplada.

  El VFS se construye en BUILD TIME (frontmatter) para que al cliente solo viaje
  el árbol ya recortado y resuelto al idioma de la página, nunca el resume.json
  maestro completo.
*/
import resume from "../../../constants/resume.json";
import pkg from "../../../../package.json";
import { separateLanguages } from "../../../shared/utils/languageSeparator";
import { buildTree } from "../fs/build";

// Nombres de las dependencias REALES del proyecto, extraídos en build time para
// que `install <dep>` responda "ya está instalado". Solo viajan los nombres al
// cliente, nunca el package.json entero.
const installPackages = [
	...Object.keys((pkg as { dependencies?: Record<string, string> }).dependencies ?? {}),
	...Object.keys((pkg as { devDependencies?: Record<string, string> }).devDependencies ?? {}),
];

interface Props {
	lang: "es" | "en" | string;
}

const lang = (Astro.props.lang === "en" ? "en" : "es") as "es" | "en";
const vfs = buildTree(separateLanguages(resume, lang), lang);

const BASE_URL = import.meta.env.BASE_URL;
const isEs = lang === "es";

const inputAria = isEs
	? "Barra de comandos opcional. Escribe help y pulsa Enter para ver los comandos."
	: "Optional command bar. Type help and press Enter to list commands.";
const placeholder = isEs
	? "Escribe help para ver la lista de comandos"
	: "Write help to see command list";
const hint = isEs ? "[ / ] enfocar · [ esc ] cerrar" : "[ / ] focus · [ esc ] close";
---

<aside
	id="fr3d-cmd"
	class="cmdbar"
	data-lang={isEs ? "es" : "en"}
	data-base={BASE_URL}
	data-packages={JSON.stringify(installPackages)}
	aria-label={isEs ? "Barra de comandos (opcional)" : "Command bar (optional)"}
	hidden>
	<div class="cmdbar__shell" id="fr3d-shell">
		<div class="cmdbar__log" id="fr3d-cmd-log" role="log" aria-live="polite">
		</div>
		<form class="cmdbar__form" id="fr3d-cmd-form" autocomplete="off">
      <div class="cmdbar__prompt-hint">
        <span class="cmdbar__hint" aria-hidden="true">{hint}</span>
        <div class="cmdbar__prompt-top" id="fr3d-prompt-top" aria-hidden="true" />
      </div>
			
			<div class="cmdbar__prompt-line">
				<label
					class="cmdbar__prompt"
					id="fr3d-prompt-bot"
					for="fr3d-cmd-input"
					aria-hidden="true"></label>
				<input
					id="fr3d-cmd-input"
					class="cmdbar__input"
					type="text"
					name="cmd"
					spellcheck="false"
					autocapitalize="off"
					autocorrect="off"
					aria-label={inputAria}
					placeholder={placeholder}
				/>
				<!-- <span class="cmdbar__hint" aria-hidden="true">{hint}</span> -->
			</div>
		</form>
	</div>
</aside>

<dialog
	id="fr3d-dialog"
	class="cmdbar-dialog"
	aria-modal="true"
	aria-label={isEs
		? "Terminal FR-3D (pantalla completa)"
		: "FR-3D terminal (fullscreen)"}>
	<div class="cmdbar-dialog__viewport" id="fr3d-dialog-viewport"></div>
</dialog>

<script
	type="application/json"
	id="fr3d-vfs"
	is:inline
	set:html={JSON.stringify(vfs).replace(/</g, "\\u003c")}
/>

<script>
	import { createState } from "../core/state";
	import { Registry } from "../core/registry";
	import type { ShellContext, ShellEffects } from "../core/registry";
	import type { TerminalSink, LineHandle } from "../core/sink";
	import { execute } from "../core/execute";
	import { COMMANDS } from "../commands";
	import { buildPrompt } from "../constants/PROMPT";
	import { isHidden, resolveNode, resolvePath } from "../fs/resolve";
	import type { CommandResult, Line, Tone } from "../core/output";
	import type { DirNode } from "../fs/types";

	const bar = document.getElementById("fr3d-cmd");
	const vfsTag = document.getElementById("fr3d-vfs");
	const form = document.getElementById(
		"fr3d-cmd-form",
	) as HTMLFormElement | null;
	const input = document.getElementById(
		"fr3d-cmd-input",
	) as HTMLInputElement | null;
	const logEl = document.getElementById("fr3d-cmd-log");
	const promptTop = document.getElementById("fr3d-prompt-top");
	const promptBot = document.getElementById("fr3d-prompt-bot");
	const shell = document.getElementById("fr3d-shell");
	const dialog = document.getElementById(
		"fr3d-dialog",
	) as HTMLDialogElement | null;
	const dialogViewport = document.getElementById("fr3d-dialog-viewport");

	if (
		bar &&
		vfsTag &&
		form &&
		input &&
		logEl &&
		promptTop &&
		promptBot &&
		shell &&
		dialog &&
		dialogViewport
	) {
		const lang = (bar.dataset.lang === "en" ? "en" : "es") as "es" | "en";
		const base = bar.dataset.base || "";
		// Nombres de dependencias reales (build time) para el comando `install`.
		let packages: string[] = [];
		try {
			const parsed = JSON.parse(bar.dataset.packages || "[]");
			if (Array.isArray(parsed)) packages = parsed.filter((p) => typeof p === "string");
		} catch {}

		// Mejora progresiva: la barra solo aparece con JS.
		bar.hidden = false;

		const fs = JSON.parse(vfsTag.textContent || "{}") as DirNode;
		const state = createState(lang);
		const registry = new Registry();
		COMMANDS.forEach((c) => registry.register(c));

		const scrollToBottom = () => {
			logEl.scrollTop = logEl.scrollHeight;
		};

		// Animación de "apertura de programa": añade .booting a la sección. Es
		// idempotente y se limpia en animationend, con watchdog de respaldo por si
		// la animación nunca dispara animationend.
		const bootSection = (el: HTMLElement) => {
			if (el.classList.contains("booting")) return;
			el.classList.add("booting");
			let watchdog = 0;
			const cleanup = () => {
				el.classList.remove("booting");
				el.removeEventListener("animationend", onEnd);
				window.clearTimeout(watchdog);
			};
			const onEnd = (e: AnimationEvent) => {
				if (e.animationName === "fr3d-boot-sweep") cleanup();
			};
			el.addEventListener("animationend", onEnd);
			watchdog = window.setTimeout(cleanup, 1400);
		};

		// Dispara el boot al terminar el scroll suave (scrollend), con fallback por
		// si no hay scrollend o la sección ya estaba a la vista (no hay scroll).
		const bootAfterScroll = (el: HTMLElement) => {
			let done = false;
			const trigger = () => {
				if (done) return;
				done = true;
				window.removeEventListener("scrollend", trigger);
				bootSection(el);
			};
			window.addEventListener("scrollend", trigger);
			window.setTimeout(trigger, 700);
		};

		// Navega a una sección: scroll suave si el id existe (+ boot); si no, pasa el
		// flag por sessionStorage y navega al ancla para que el destino lo reproduzca.
		const goSection = (id: string) => {
			const el = document.getElementById(id);
			if (el) {
				el.scrollIntoView({ behavior: "smooth" });
				history.replaceState(null, "", `#${id}`);
				bootAfterScroll(el);
			} else {
				try {
					sessionStorage.setItem("fr3d:boot", id);
				} catch {}
				window.location.href = `${base}/${lang}/#${id}`;
			}
		};

		// Pantalla completa: mueve el shell (log + form) a un <dialog> y usa
		// showModal() para tener focus trap, ::backdrop y Esc nativos. Es la ÚNICA
		// excepción al contrato de "no capturar el foco": un overlay a pantalla
		// completa DEBE comportarse como modal, y lo invoca el usuario a propósito.
		let isFullscreen = false;
		let lastActiveBeforeFs: HTMLElement | null = null;

		const enterFullscreen = () => {
			if (isFullscreen) return;
			lastActiveBeforeFs = document.activeElement as HTMLElement | null;
			dialogViewport.appendChild(shell);
			dialog.showModal();
			isFullscreen = true;
			// No autoenfocar en móvil: dispararía el teclado virtual sin pedirlo.
			if (!window.matchMedia("(pointer: coarse)").matches) input.focus();
			scrollToBottom();
		};

		const exitFullscreen = () => {
			if (!isFullscreen) return;
			bar.appendChild(shell);
			dialog.close();
			isFullscreen = false;
			(lastActiveBeforeFs ?? input).focus();
		};

		const toggleFullscreen = () =>
			isFullscreen ? exitFullscreen() : enterFullscreen();

		// Esc en el modal dispara `cancel`: lo interceptamos para volver a acoplado
		// en vez de cerrar del todo (mismo patrón que ExperienceDetail.astro).
		dialog.addEventListener("cancel", (e) => {
			e.preventDefault();
			// Jerarquía de Esc: una tarea en curso se aborta antes que salir de
			// pantalla completa.
			if (taskRunning) {
				abortTask();
				return;
			}
			exitFullscreen();
		});

		/* ----- Motor de tareas: sink, estado ocupado y cancelación --------- */

		// Placeholder original del input (localizado en el frontmatter), para
		// restaurarlo al salir del estado ocupado.
		const defaultPlaceholder = input.placeholder;

		// Una tarea a la vez. La terminal es dueña del AbortController; se renueva
		// por comando (ver submit) y lo abortan Ctrl+C / Esc. `taskRunning` refleja
		// busy() y decide si Ctrl+C aborta una tarea o solo limpia el input.
		let taskController: AbortController | null = null;
		let taskRunning = false;

		// Bloquea/libera el input mientras corre una tarea. Las teclas pulsadas
		// durante la ejecución se descartan (input disabled), no se encolan.
		const setBusy = (running: boolean) => {
			taskRunning = running;
			input.disabled = running;
			shell.setAttribute("aria-busy", running ? "true" : "false");
			form.dataset.busy = running ? "true" : "false";
			if (running) {
				input.value = "";
				input.placeholder = lang === "es" ? "trabajando…" : "working…";
			} else {
				input.placeholder = defaultPlaceholder;
			}
		};

		// El sink que consume el runner: reutiliza appendLine/fillSegments. El
		// handle de una línea es el <div> que appendLine devuelve; sobrevive al
		// movimiento del shell entre acoplado y <dialog> (es una referencia a nodo).
		const taskSink: TerminalSink = {
			write: (lineData, announce = false) => {
				const el = appendLine(lineData, !announce);
				scrollToBottom();
				return el as LineHandle;
			},
			// Siempre vía fillSegments: reasignar textContent dejaría la línea sin
			// tono (el color es inline) y saldría en --red-core sin avisar.
			update: (handle, lineData) => fillSegments(handle as HTMLElement, lineData),
			busy: (running) => setBusy(running),
			reducedMotion: () =>
				window.matchMedia("(prefers-reduced-motion: reduce)").matches,
		};

		// Aborta la tarea en curso y deja rastro (^C), como la interrupción normal.
		// El runner libera el input en su `finally` poco después.
		const abortTask = () => {
			if (!taskRunning || !taskController) return;
			taskController.abort();
			const [top, bot] = buildPrompt(state);
			appendLine(top, true);
			appendLine([...bot, { text: " ^C", tone: "dim" }], true);
			scrollToBottom();
		};

		// Cambio de página a mitad de tarea: abortar para no dejar temporizadores
		// huérfanos (pagehide cubre también las view transitions de Astro).
		window.addEventListener("pagehide", () => taskController?.abort());

		const effects: ShellEffects = {
			clear: () => logEl.replaceChildren(),
			open: (url) => {
				window.open(url, "_blank", "noopener");
			},
			navigate: (path) => {
				window.location.href = `${base}/${lang}/${path}`;
			},
			openSection: (id) => goSection(id),
			toggleLang: () => {
				const path = window.location.pathname;
				window.location.href = path.includes("/es/")
					? path.replace("/es/", "/en/")
					: path.replace("/en/", "/es/");
			},
			toggleFullscreen: () => toggleFullscreen(),
			task: taskSink,
			// La señal se renueva por comando en el submit; lazy por seguridad.
			taskSignal: () => (taskController ??= new AbortController()).signal,
		};

		const ctx: ShellContext = { state, fs, registry, lang, effects, packages };

		// Estado de ergonomía de shell (historial, autocompletado).
		let historyIndex = state.history.length; // índice en state.history; length = borrador
		let draft = ""; // línea en construcción, guardada al empezar a navegar el historial
		let tabStuck = false; // Tab previo sin progreso → el siguiente lista opciones

		// El color se aplica INLINE, no por clase CSS: los <span>/<a>/<div> se crean
		// en JS y no llevan el atributo de scope de Astro, así que las clases .tone-*
		// scopeadas nunca les aplicarían (todo saldría en --red-core). Inline es a
		// prueba de scoping. Mapea cada Tone a su token (tabla del PASO 1).
		const TONE_COLOR: Record<Tone, string> = {
			default: "var(--red-core)",
			dim: "color-mix(in srgb, var(--red-core) 55%, transparent)",
			data: "var(--cyan-glow)",
			accent: "var(--amber-glow)",
			alert: "var(--red-glow)",
			ok: "var(--cyan-accent)",
		};

		// Decodifica el href de un segmento enlazado y lo enruta por effects, de
		// modo que "ver completo en el sitio" converge con el comando `open`.
		const runHref = (href: string) => {
			const idx = href.indexOf(":");
			const scheme = href.slice(0, idx);
			const value = href.slice(idx + 1);
			if (scheme === "section") effects.openSection(value);
			else if (scheme === "page") effects.navigate(value);
			else if (scheme === "link") effects.open(value);
		};

		// Rellena un elemento con los segmentos de una línea.
		// Render con textContent / createElement — nunca innerHTML con datos.
		const fillSegments = (el: HTMLElement, segments: Line) => {
			el.replaceChildren();
			if (segments.length === 0) {
				el.appendChild(document.createTextNode(" "));
				return;
			}
			for (const s of segments) {
				const tone = s.tone ?? "default";
				const node = document.createElement(s.href ? "a" : "span");
				node.className = "cmdbar__seg";
				node.textContent = s.text;
				node.style.color = TONE_COLOR[tone];
				if (tone === "alert") node.style.textShadow = "var(--text-glow-red)";
				if (s.href) {
					const a = node as HTMLAnchorElement;
					a.href = "#";
					a.style.textDecoration = "underline";
					a.style.cursor = "pointer";
					const target = s.href;
					a.addEventListener("click", (e) => {
						e.preventDefault();
						runHref(target);
					});
				}
				el.appendChild(node);
			}
		};

		// a11y: el log es aria-live="polite". Para no leer 20 líneas de `tree`,
		// el eco y todo salvo la primera línea útil del resultado van aria-hidden;
		// así solo se anuncia esa primera línea (constraint #4: el log sigue polite).
		const appendLine = (lineData: Line, ariaHidden = false): HTMLDivElement => {
			const div = document.createElement("div");
			div.className = "cmdbar__line";
			div.style.whiteSpace = "pre-wrap";
			div.style.wordBreak = "break-word";
			if (ariaHidden) div.setAttribute("aria-hidden", "true");
			fillSegments(div, lineData);
			logEl.appendChild(div);
			return div;
		};

		// Prompt de la barra: se construye desde state y se re-renderiza tras cada
		// comando para que `cd` lo actualice solo.
		const renderPrompt = () => {
			const [top, bot] = buildPrompt(state);
			fillSegments(promptTop, top);
			fillSegments(promptBot, bot);
		};

		// Eco en el log: conserva el prompt activo al ejecutar + el comando.
		// aria-hidden: el usuario acaba de teclearlo, no hace falta releerlo.
		const echoCommand = (raw: string, prompt: [Line, Line]) => {
			appendLine(prompt[0], true);
			appendLine([...prompt[1], { text: " " + raw, tone: "default" }], true);
		};

		// Anuncia solo la primera línea útil; el resto va aria-hidden.
		const renderResult = (result: CommandResult) => {
			let announced = false;
			for (const l of result.lines) {
				const empty = l.every((s) => s.text.trim() === "");
				const hide = announced || empty;
				appendLine(l, hide);
				if (!hide) announced = true;
			}
		};

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const raw = input.value;
			input.value = "";
			if (!raw.trim()) return;
			const prompt = buildPrompt(state); // prompt activo (cwd previo al comando)
			echoCommand(raw, prompt);
			// Señal fresca por comando: si el comando lanza una tarea, Ctrl+C / Esc
			// abortan ESTA ejecución. Los comandos síncronos la ignoran.
			taskController = new AbortController();
			const wasFocused = document.activeElement === input;
			const result = await execute(raw, ctx);
			if (result) renderResult(result);
			// Foco tras una tarea: al deshabilitar el input durante la animación el
			// foco cae en <body>. Se lo devolvemos solo si sigue evaporado ahí (fue
			// cosa nuestra); si el usuario se fue a otro elemento, no se lo robamos.
			if (wasFocused && !input.disabled) {
				const ae = document.activeElement;
				if (!ae || ae === document.body) input.focus();
			}
			historyIndex = state.history.length; // ↑ arranca desde el más reciente
			draft = "";
			tabStuck = false;
			renderPrompt(); // refleja el nuevo cwd si `cd` lo cambió
			scrollToBottom();
		});

		// Clic en cualquier parte del prompt acoplado enfoca el input (colapsado
		// hasta enfocar, así que su área de clic propia es mínima sin esto).
		form.addEventListener("click", (e) => {
			if (!(e.target as HTMLElement).closest("a")) input.focus();
		});

		renderPrompt(); // prompt inicial

		// Si venimos de un `open` cross-página, reproducir el boot en el destino.
		// Se borra el flag YA (antes de animar) para no repetirlo al refrescar o
		// volver con el botón atrás. Doble rAF para no competir con la view
		// transition entre documentos (@view-transition navigation: auto).
		try {
			const bootId = sessionStorage.getItem("fr3d:boot");
			if (bootId) {
				sessionStorage.removeItem("fr3d:boot");
				const target = document.getElementById(bootId);
				if (target) {
					requestAnimationFrame(() =>
						requestAnimationFrame(() => bootSection(target)),
					);
				}
			}
		} catch {}

		/* ----- Ergonomía de shell: historial, Tab, Ctrl+L, Ctrl+C ----------- */

		const moveCursorToEnd = () => {
			const len = input.value.length;
			input.setSelectionRange(len, len);
		};

		const commonPrefix = (arr: string[]): string => {
			if (arr.length === 0) return "";
			let p = arr[0];
			for (const s of arr) while (!s.startsWith(p)) p = p.slice(0, -1);
			return p;
		};

		// Candidatos de ruta para el token actual, relativos al cwd.
		const pathCandidates = (
			token: string,
		): { dirPart: string; names: string[] } => {
			const slash = token.lastIndexOf("/");
			const dirPart = slash >= 0 ? token.slice(0, slash + 1) : "";
			const namePart = slash >= 0 ? token.slice(slash + 1) : token;
			const basePath = resolvePath(dirPart || ".", state.cwd, state.env.HOME);
			const node = resolveNode(fs, basePath);
			if (!node || node.type !== "dir") return { dirPart, names: [] };
			const names = node.children
				.filter((c) => (namePart.startsWith(".") ? true : !isHidden(c.name)))
				.filter((c) => c.name.startsWith(namePart))
				.map((c) => c.name + (c.type === "dir" ? "/" : ""));
			return { dirPart, names };
		};

		const setToken = (
			tokens: string[],
			i: number,
			value: string,
			after: string,
		) => {
			tokens[i] = value;
			input.value = tokens.join(" ") + after;
			const caret = tokens.join(" ").length;
			input.setSelectionRange(caret, caret);
		};

		// Tab: primera palabra → comandos; resto → entradas del directorio.
		const handleTab = () => {
			const value = input.value;
			const pos = input.selectionStart ?? value.length;
			const after = value.slice(pos);
			const tokens = value.slice(0, pos).split(" ");
			const ti = tokens.length - 1;
			const token = tokens[ti];

			let candidates: string[];
			if (ti === 0) {
				candidates = registry.names().filter((n) => n.startsWith(token));
			} else {
				const { dirPart, names } = pathCandidates(token);
				candidates = names.map((n) => dirPart + n);
			}
			if (candidates.length === 0) return;

			if (candidates.length === 1) {
				const done = candidates[0];
				setToken(tokens, ti, done.endsWith("/") ? done : done + " ", after);
				tabStuck = false;
				return;
			}

			const prefix = commonPrefix(candidates);
			if (prefix.length > token.length) {
				setToken(tokens, ti, prefix, after);
				tabStuck = false;
			} else if (tabStuck) {
				// Segundo Tab sin progreso: lista de opciones (solo basenames).
				const labels = candidates.map((c) => {
					const isDir = c.endsWith("/");
					const base = c.replace(/\/$/, "").split("/").pop() ?? c;
					return isDir ? base + "/" : base;
				});
				appendLine(
					labels.map((d, i) => ({
						text: (i ? "  " : "") + d,
						tone: "data" as const,
					})),
				);
				scrollToBottom();
				tabStuck = false;
			} else {
				tabStuck = true;
			}
		};

		input.addEventListener("keydown", (e) => {
			if (e.key !== "Tab") tabStuck = false;

			if (e.key === "ArrowUp") {
				e.preventDefault();
				if (state.history.length === 0) return;
				if (historyIndex === state.history.length) draft = input.value;
				historyIndex = Math.max(0, historyIndex - 1);
				input.value = state.history[historyIndex];
				moveCursorToEnd();
			} else if (e.key === "ArrowDown") {
				e.preventDefault();
				if (historyIndex === state.history.length) return;
				historyIndex += 1;
				input.value =
					historyIndex === state.history.length
						? draft
						: state.history[historyIndex];
				moveCursorToEnd();
			} else if (e.key === "Tab") {
				e.preventDefault();
				handleTab();
			} else if (e.ctrlKey && (e.key === "l" || e.key === "L")) {
				e.preventDefault();
				effects.clear();
			} else if (e.ctrlKey && (e.key === "c" || e.key === "C")) {
				e.preventDefault();
				const [top, bot] = buildPrompt(state);
				appendLine(top, true);
				appendLine(
					[...bot, { text: " " + input.value + "^C", tone: "dim" }],
					true,
				);
				input.value = "";
				historyIndex = state.history.length;
				draft = "";
				scrollToBottom();
			}
		});

		// Atajos globales:
		// - Ctrl+`  alterna acoplado ↔ pantalla completa.
		// - `/` o `` ` `` enfocan la barra (salvo que ya se escriba en otro campo).
		// - Esc: en pantalla completa → acoplado (vía `cancel` del dialog);
		//        acoplado y enfocado → desenfoca.
		document.addEventListener("keydown", (e) => {
			const active = document.activeElement as HTMLElement | null;
			const typing =
				!!active &&
				(active.tagName === "INPUT" ||
					active.tagName === "TEXTAREA" ||
					active.isContentEditable);

			// Tarea en curso: el input está disabled, así que su propio manejador de
			// Ctrl+C no dispara; se atienden aquí. Esc en pantalla completa lo cubre
			// el `cancel` del dialog. Ctrl+` (pantalla completa) sigue permitido.
			if (taskRunning) {
				if (e.ctrlKey && (e.key === "c" || e.key === "C")) {
					e.preventDefault();
					abortTask();
					return;
				}
				if (e.key === "Escape" && !isFullscreen) {
					e.preventDefault();
					abortTask();
					return;
				}
			}

			if (e.ctrlKey && e.key === "`") {
				e.preventDefault();
				toggleFullscreen();
			} else if ((e.key === "/" || e.key === "`") && !typing) {
				e.preventDefault();
				input.focus();
			} else if (e.key === "Escape" && !isFullscreen && active === input) {
				input.blur();
			}
		});
	}
</script>

