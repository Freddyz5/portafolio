---
const { title } = Astro.props;
---

<section>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 700px;
    margin: 0 auto 48px;
  }

  h2 {
    color: #000;
    margin-bottom: 0.9rem;
    line-height: 1.5;
    border-bottom: 1px solid #000000;
  }

  @media (width <= 700px) {
    section {
      margin-bottom: 38px;
    }
  }
</style>