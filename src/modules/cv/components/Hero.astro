---
import MapPin from '../../../shared/icons/MapPin.astro';
import Mail from '../../../shared/icons/Mail.astro';
import Phone from '../../../shared/icons/Phone.astro';
import Link from '../../../shared/icons/Link.astro';
import Linkedin from '../../../shared/icons/Linkedin.astro';
import Github from '../../../shared/icons/Github.astro';

import { basics } from "../../../shared/languages/es.json"

const { name, email, phone, url, location, profiles } = basics;
const { city, region } = location;
---
<header>
  <h1>{name}</h1>
  <div class="container">
    <span>
      <MapPin />
      {city}, {region}
    </span>

    <a 
      href={`mailto:${email}`}
      title={`Enviar un correo electrónico a ${name} al correo ${email}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Mail />
      {email}
    </a>

    <a
      href={`tel:${phone}`}
      title={`Llamar por teléfono a ${name} al número ${phone}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Phone />
      {phone}
    </a>

    <a
      href={url}
      title={`Visitar el portafolio de ${name} en ${url}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Link />
      Portafolio
    </a>

    <a 
      href={profiles[0].url}
      title={`Visitar el perfil de ${name} en ${profiles[0].url}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Linkedin />
      {profiles[0].username}
    </a>

    <a 
      href={profiles[1].url}
      title={`Visitar el perfil de ${name} en ${profiles[1].url}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Github />
      {profiles[1].username}
    </a>
  </div>
</header>

<style>
  header {
    max-width: 700px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  a, span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: black;
  }
</style>