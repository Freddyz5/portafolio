---
import MapPin from '../../../shared/icons/MapPin.astro';
import Mail from '../../../shared/icons/Mail.astro';
import Phone from '../../../shared/icons/Phone.astro';
import Link from '../../../shared/icons/Link.astro';
import LinkedIn from '../../../shared/icons/Linkedin.astro';
import GitHub from '../../../shared/icons/Github.astro';
import type { AstroComponentFactory } from 'astro/dist/runtime/server';

interface Props {
  basics: any;
}

const { basics } = Astro.props;
const { name, email, phone, url, location, socialProfiles } = basics;
const { city, country } = location;

const SOCIAL_ICONS: Record<string, AstroComponentFactory> = {
  GitHub,
  LinkedIn,
}

---
<header>
  <h1>{name}</h1>
  <div class="container">
    {location && city && country && (
      <span>
        <div class="no-print"><MapPin width="18" height="18" /></div>
        {city} - {country}
      </span>
    )}
    <div class="print"> • </div>
    {email && (
      <a
        href={`mailto:${email}`}
        title={`Enviar un correo electrónico a ${name} al correo ${email}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="no-print"><Mail width="18" height="18" /></div>
        {email}
      </a>
    )}
    <div class="print"> • </div>
    {phone && (
      <a
        href={`tel:${phone}`}
        title={`Llamar por teléfono a ${name} al número ${phone}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="no-print"><Phone width="18" height="18" /></div>
        {phone}
      </a>
    )}
    {url && (
      <a
        href={url}
        title={`Visitar el portafolio de ${name} en ${url}`}
        target="_blank"
        rel="noopener noreferrer"
        class="no-print"
      >
        <Link width="18" height="18" />
        Portafolio
      </a>
    )}
    {socialProfiles && socialProfiles.map(({ network, url, username }: { network: string; url: string; username: string }) => {
      if (network === 'Instagram') return null;
      const Icon = SOCIAL_ICONS[network]
      if (!Icon) return null;
      return (
        <a
          href={url}
          title={`Visitar el perfil de ${name} en ${network}`}
          target="_blank"
          rel="noopener noreferrer"
          class="no-print"
        >
          <Icon width="18" height="18" />
          {username}
        </a>
      )
    })}
  </div>
  
</header>

<style>
  header {
    max-width: 700px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  a, span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: black;
  }
</style>