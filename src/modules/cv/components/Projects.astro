---
import Section from "../components/Section.astro";
import { highlightText } from "src/shared/utils/highlightText";

interface Props {
  projects: any[];
  lang: 'es' | 'en';
}

const { projects, lang } = Astro.props;
---

<Section title={lang === 'es' ? 'Proyectos' : 'Projects'}>
  <ul class="projects">
    {projects.map(({ name, summary, startDate, endDate, status, highlights, technologies, url, repo }) => {
      const formattedDate = (date: string) => {
        const formattedDate = new Date(date).toLocaleString((lang === 'es' ? 'es-ES' : 'en-US'), { year: 'numeric', month: 'long'});
        const result = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1).replace(' de', '');
        return result;
      }

      const startYear = formattedDate(startDate)
      const endYear = endDate !== null ? formattedDate(endDate) : (lang === 'es' ? 'Actualidad' : 'Present');

      return (
        <li>
          <article>
            <header>
              <div>
                <h3>
                  <a href={url} title={`Ver ${name}`} target="_blank">
                    {name}
                  </a>
                </h3>
                <h4>{status}</h4>
                <h5>{technologies && technologies.join(' • ')}</h5>
              </div>

              <time>{startYear} - {endYear}</time>
            </header>

            <footer>
              <p>{summary}</p>
              {highlights && highlights.length > 0 &&
                <ul>
                  {highlights.map((highlight: unknown) => (
                    <li>
                      <p>{highlightText(highlight)}</p>
                    </li>
                  ))}
                </ul>
              }
            </footer>
          </article>
        </li>
      )
    })}
  </ul>
</Section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .projects article  div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  article h3 {
    font-weight: 500;
  }

  article a {
    font-weight: bold;
    color: #444;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4, article h5 {
    font-weight: 400;
    margin: 0;
  }

  time {
    font-size: 0.85rem;
    min-width: 102px;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  footer ul {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style-type: circle;
    padding-left: 1rem;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>