---
import Section from "../components/Section.astro";

interface Props {
  skills: any;
  lang: 'es' | 'en';
}

const { skills, lang } = Astro.props;

---

<Section title={lang === 'es' ? 'Habilidades de programación' : 'Programming Skills'}>
  <ul class="skills">
    {skills && skills.map(({ name, keywords }: { name: string, keywords: string[] }) => (
      <li><span>{name}:</span> {keywords.join(", ")}</li>
    ))}
  </ul>
</Section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
  }
  li {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }
  li span {
    color: #444;
    font-weight: bold;
  }
</style>