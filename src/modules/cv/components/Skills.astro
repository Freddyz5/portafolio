---
import Section from "../components/Section.astro";

interface Props {
  skills: any;
}

const { skills } = Astro.props;

const { languagesArray, frameworksLibrariesArray, technologiesArray } = skills.reduce((acc: any, skill: any) => {
  if (skill.id.includes("language")) acc.languagesArray.push(skill);
  else if (skill.id.includes("framework-library")) acc.frameworksLibrariesArray.push(skill);
  else if (skill.id.includes("technology")) acc.technologiesArray.push(skill);
  return acc;
},
{
  languagesArray: [],
  frameworksLibrariesArray: [],
  technologiesArray: [],
});

const formatSkillNames = (skillsArray: any[]) => {
  return skillsArray.map(({ name }: { name: string }) => name).join(", ");
};

---

<Section title="Habilidades de programación">
  <ul class="skills">
    <li><span>Lenguajes: </span> {formatSkillNames(languagesArray)}</li>
    <li><span>Frameworks / Librerías: </span> {formatSkillNames(frameworksLibrariesArray)}</li>
    <li><span>Tecnologías: </span> {formatSkillNames(technologiesArray)}</li>
  </ul>
</Section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
  }
  li {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }
  li span {
    color: #444;
    font-weight: bold;
  }
</style>