---
import Section from "../components/Section.astro"

interface Props {
  certificates: any[];
  lang: 'es' | 'en';
}

const { certificates, lang } = Astro.props;
---

<Section title={lang === 'es' ? 'Educación Suplementaria' : 'Supplementary Education'}>
  <ul>
    {certificates.map(({ issuer, name, date, url }) => {
      const year = new Date(date).toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'short'});

      return (
        <li>
          <article>
            <header>
              <div>
                <h3>{issuer}</h3>
              </div>

              <time>{year}</time>
            </header>

            <footer>
              <a href={url} title="Ver el certificado" target="_blank">
                {name}
              </a>
            </footer>
          </article>
        </li>
      )
    })}
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: bold;
    color: #444;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    font-size: 0.85rem;
    min-width: 102px;
  }

  footer a {
    color: black;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  footer a:hover {
    text-decoration: underline;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
