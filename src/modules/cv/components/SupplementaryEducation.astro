---
import Section from "../components/Section.astro"

interface Props {
  certificates: any[];
}

const { certificates } = Astro.props;
---

<Section title="Educación Suplementaria">
  <ul>
    {certificates.map(({ issuer, name, date, url }) => {
      const year = new Date(date).toLocaleString('es-ES', { year: 'numeric', month: 'short'});

      return (
        <li>
          <article>
            <header>
              <div>
                <h3>{issuer}</h3>
              </div>

              <time>{year}</time>
            </header>

            <footer>
              <a href={url} title={`Ver ${name}`} target="_blank">
                {name}
              </a>
            </footer>
          </article>
        </li>
      )
    })}
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  footer a {
    color: #111;
  }

  footer a:hover {
    text-decoration: underline;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
