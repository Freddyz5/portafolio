---
import Section from '../components/Section.astro';
import { highlightText } from 'src/shared/utils/highlightText';

interface Props {
  works: any[];
  lang: 'es' | 'en';
}

const { works, lang } = Astro.props;
---

<Section title={lang === 'es' ? 'Experiencia Laboral' : 'Work Experience'}>
  <ul class="works">
    {works.map(({ name, position, url, startDate, endDate, summary, highlights, teams }) => {
      const formattedDate = (date: string) => {
        const formattedDate = new Date(date).toLocaleString((lang === 'es' ? 'es-ES' : 'en-US'), { year: 'numeric', month: 'long'});
        const result = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1).replace(' de', '');
        return result;
      }

      const startYear = formattedDate(startDate)
      const endYear = endDate !== null ? formattedDate(endDate) : (lang === 'es' ? 'Actualidad' : 'Present');

      return (
        <li>
          <article>
            <header>
              <div>
                <h3>
                  <a href={url} title={`Ver ${name}`} target="_blank">
                    {name}
                  </a>
                </h3>
                <h4>{position}</h4>
              </div>

              <time>{startYear} - {endYear}</time>
            </header>

            <footer>
              <p>{summary}</p>
              {highlights && highlights.length > 0 &&
                <ul class="highlights">
                  {highlights.map((highlight: unknown) => (
                    <li>
                      <p>{highlightText(highlight)}</p>
                    </li>
                  ))}
                </ul>
              }
              {teams && teams.length > 0 &&
                <ul class="teams">
                  {teams.map((team: any) => {
                    const { teamName, role, stack, summary, highlights } = team;
                    const sortedHighlights = Array.isArray(highlights)
                      ? [...highlights].sort((a, b) => (a?.priority ?? 0) - (b?.priority ?? 0))
                      : [];
                    return (
                      <li>
                        <h5 class="teamName">{teamName}</h5>
                        {role && <p class="teamRole">{role}</p>}
                        {stack && stack.length > 0 && <p class="teamStack">{stack.join(' • ')}</p>}
                        {summary && <p>{summary}</p>}
                        {sortedHighlights.length > 0 &&
                          <ul class="highlights">
                            {sortedHighlights.map((highlight: unknown) => (
                              <li>
                                <p>{highlightText(highlight)}</p>
                              </li>
                            ))}
                          </ul>
                        }
                      </li>
                    );
                  })}
                </ul>
              }
            </footer>
          </article>
        </li>
      )
    })}
  </ul>
</Section>

<style>
  .works {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
  }

  article a {
    font-weight: bold;
    color: #444;
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    font-weight: lighter;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  header div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  time {
    font-size: 0.85rem;
    min-width: 102px;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  footer p {
    break-inside: avoid;
  }

  footer .highlights {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style-type: circle;
    padding-left: 1rem;
    break-inside: avoid;
  }

  footer .teams {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    list-style-type: square;
    padding-left: 1rem;
    break-inside: avoid;
  }

  .teamName {
    line-height: 1.5;
    margin: 0;
    color: #555;
  }

  .teamRole {
    margin: 0;
    font-weight: 500;
    color: #555;
  }

  .teamStack {
    margin: 0;
    font-size: 0.8rem;
    color: #777;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>