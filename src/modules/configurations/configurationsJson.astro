---
import ButtonGlitch from "../portfolio/components/ButtonGlitch.astro";
import Section from "./components/SectionJson.astro";
interface Props {
  data: any;
}

const { data } = Astro.props;
---
<Section title="JSON Editor" subTittle="EDITA_TU_JSON_AQUI">
  <div class="actions" slot="buttons">
    <ButtonGlitch
      id="formatBtn"
      text="Formatear"
      width="50%"
      />
      <ButtonGlitch
      id="consoleBtn"
      text="Imprimir"
      width="50%"
      color="secondary"
    />
  </div>

  <div class="editor-wrapper">
    <textarea id="jsonEditor" spellcheck="false"></textarea>
  </div>

  <div id="status" class="status"></div>
</Section>

<script define:vars={{ data }}>
  const editor = document.getElementById('jsonEditor');
  const formatBtn = document.getElementById('formatBtn');
  const consoleBtn = document.getElementById('consoleBtn');
  const statusDiv = document.getElementById('status');

  // Cargar datos iniciales
  editor.value = JSON.stringify(data, null, 2);

  // Función para mostrar mensajes de estado
  function showStatus(message, type = 'info') {
    statusDiv.textContent = message;
    statusDiv.className = `status ${type}`;
    setTimeout(() => {
      statusDiv.textContent = '';
      statusDiv.className = 'status';
    }, 3000);
  }

  // Formatear JSON
  formatBtn.addEventListener('click', () => {
    try {
      const jsonText = editor.value;
      const parsed = JSON.parse(jsonText);
      editor.value = JSON.stringify(parsed, null, 2);
      showStatus('✅ JSON formateado correctamente', 'success');
    } catch (error) {
      showStatus(`❌ Error al formatear: ${error.message}`, 'error');
    }
  });

  // Imprimir en consola
  consoleBtn.addEventListener('click', () => {
    try {
      const jsonText = editor.value;
      const parsed = JSON.parse(jsonText);
      
      console.clear();
      console.log('='.repeat(80));
      console.log('📋 RESUME.JSON PREVIEW');
      console.log('='.repeat(80));
      console.log(parsed);
      console.log('='.repeat(80));
      console.log('JSON String:');
      console.log(JSON.stringify(parsed, null, 2));
      console.log('='.repeat(80));
      
      showStatus('✅ JSON impreso en consola (abre DevTools para verlo)', 'success');
    } catch (error) {
      showStatus(`❌ Error: JSON inválido - ${error.message}`, 'error');
      console.error('Error al parsear JSON:', error);
    }
  });

  // Auto-save en localStorage
  let saveTimeout;
  editor.addEventListener('input', () => {
    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => {
      localStorage.setItem('json-draft', editor.value);
      showStatus('💾 Guardado borrador localmente', 'info');
    }, 1000);
  });

  // Recuperar borrador si existe
  const draft = localStorage.getItem('json-draft');
  if (draft && confirm('Se encontró un borrador guardado. ¿Desea recuperarlo?')) {
    editor.value = draft;
    showStatus('📄 Borrador recuperado', 'info');
  }

  // Atajos de teclado
  editor.addEventListener('keydown', (e) => {
    // Ctrl/Cmd + S para formatear
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      formatBtn.click();
    }
    
    // Ctrl/Cmd + Enter para imprimir en consola
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      consoleBtn.click();
    }

    // Tab para indentar
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
      editor.selectionStart = editor.selectionEnd = start + 2;
    }
  });
</script>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--color-bg-lighter);
  }

  h1 {
    font-size: 24px;
    font-weight: 600;
    text-shadow: 0 0 10px var(--color-glow);
    color: var(--color-text);
  }

  .actions {
    position: fixed;
    display: flex;
    gap: 1rem;
    width: 40%;
    padding: 1rem;
    border-radius: 8px;
    background-color: color-mix(in srgb, var(--color-bg) 50%, transparent);
    backdrop-filter: blur(5px);
  }

  .editor-wrapper {
    width: 100%;
    display: flex;
    padding: 0.2rem;
    border: 1px solid var(--color-muted);
    border-radius: 4px;
    background-color: var(--color-muted);
  }

  #jsonEditor {
    width: 100%;
    field-sizing: content;
    padding: 1rem;
    font-size: 14px;
    line-height: 1.6;
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 4px;
    border: none;
    resize: none;
    outline: none;
  }

  #jsonEditor::selection {
    background: var(--color-muted);
  }

  .status {
    margin-top: 15px;
    padding: 12px;
    border-radius: 6px;
    font-size: 14px;
    min-height: 45px;
    display: flex;
    align-items: center;
    background: var(--color-bg-darker);
    border: 1px solid var(--color-bg-lighter);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .status.success {
    border-left: 3px solid var(--color-secondary-glow);
    opacity: 1;
    box-shadow: 0 0 10px rgba(0, 247, 255, 0.3);
  }

  .status.error {
    border-left: 3px solid var(--color-glow);
    opacity: 1;
    box-shadow: 0 0 10px rgba(255, 8, 0, 0.3);
  }

  .status.info {
    border-left: 3px solid var(--color-secondary-accent);
    opacity: 1;
    box-shadow: 0 0 10px rgba(0, 184, 191, 0.3);
  }

  /* Scrollbar personalizado */
  #jsonEditor::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  #jsonEditor::-webkit-scrollbar-track {
    background: var(--color-bg-darker);
  }

  #jsonEditor::-webkit-scrollbar-thumb {
    background: var(--color-bg-lighter);
    border-radius: 6px;
  }

  #jsonEditor::-webkit-scrollbar-thumb:hover {
    background: var(--color-muted);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      padding: 10px;
    }

    header {
      flex-direction: column;
      gap: 15px;
      align-items: flex-start;
    }

    .actions {
      width: 100%;
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>