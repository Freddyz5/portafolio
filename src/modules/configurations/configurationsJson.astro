---
import ButtonGlitch from "../portfolio/components/ButtonGlitch.astro";
import Section from "./components/SectionJson.astro";
interface Props {
  data: any;
}

const { data } = Astro.props;
---
<Section
  title="JSON Editor"
  subTittle="EDITA_TU_JSON_AQUI"
  styles={{
    backgroundColor: "var(--color-bg-darker)",
  }}
>
  <div class="actions" slot="buttons">
    <ButtonGlitch
      id="formatBtn"
      text="Formatear"
      width="50%"
      />
      <ButtonGlitch
      id="consoleBtn"
      text="Imprimir"
      width="50%"
      color="secondary"
    />
  </div>

  <div class="editor-wrapper">
    <div class="line-numbers" id="lineNumbers"></div>
    <pre id="jsonDisplay" class="json-display"></pre>
    <textarea id="jsonEditor" spellcheck="false"></textarea>
  </div>

  <div id="status" class="status"></div>
</Section>

<script define:vars={{ data }}>
  const editor = document.getElementById('jsonEditor');
  const jsonDisplay = document.getElementById('jsonDisplay');
  const lineNumbers = document.getElementById('lineNumbers');
  const formatBtn = document.getElementById('formatBtn');
  const consoleBtn = document.getElementById('consoleBtn');
  const statusDiv = document.getElementById('status');

  // Función para highlight JSON
  function highlightJSON(json) {
    return json
      .replace(/("([^"\\]|\\.)*")\s*:/g, '<span class="json-key">$1</span>:')
      .replace(/:\s*("([^"\\]|\\.)*")/g, ': <span class="json-string">$1</span>')
      .replace(/:\s*(-?\d+\.?\d*)/g, ': <span class="json-number">$1</span>')
      .replace(/:\s*(true|false)/g, ': <span class="json-boolean">$1</span>')
      .replace(/:\s*(null)/g, ': <span class="json-null">$1</span>')
      .replace(/([{}\[\]])/g, '<span class="json-bracket">$1</span>');
  }

  // Función para actualizar números de línea
  function updateLineNumbers() {
    const lines = editor.value.split('\n').length;
    lineNumbers.innerHTML = Array.from({ length: lines }, (_, i) => 
      `<div class="line-number">${i + 1}</div>`
    ).join('');
  }

  // Función para sincronizar el display con el editor
  function syncDisplay() {
    const highlighted = highlightJSON(editor.value);
    jsonDisplay.innerHTML = highlighted + '\n';
    updateLineNumbers();
  }

  // Sincronizar scroll
  editor.addEventListener('scroll', () => {
    jsonDisplay.scrollTop = editor.scrollTop;
    jsonDisplay.scrollLeft = editor.scrollLeft;
    lineNumbers.scrollTop = editor.scrollTop;
  });

  // Cargar datos iniciales
  editor.value = JSON.stringify(data, null, 2);
  syncDisplay();

  // Función para mostrar mensajes de estado
  function showStatus(message, type = 'info') {
    statusDiv.textContent = message;
    statusDiv.className = `status ${type}`;
    setTimeout(() => {
      statusDiv.textContent = '';
      statusDiv.className = 'status';
    }, 3000);
  }

  // Formatear JSON
  formatBtn.addEventListener('click', () => {
    try {
      const jsonText = editor.value;
      const parsed = JSON.parse(jsonText);
      editor.value = JSON.stringify(parsed, null, 2);
      syncDisplay();
      showStatus('✅ JSON formateado correctamente', 'success');
    } catch (error) {
      showStatus(`❌ Error al formatear: ${error.message}`, 'error');
    }
  });

  // Imprimir en consola
  consoleBtn.addEventListener('click', () => {
    try {
      const jsonText = editor.value;
      const parsed = JSON.parse(jsonText);
      
      console.clear();
      console.log('='.repeat(80));
      console.log('📋 RESUME.JSON PREVIEW');
      console.log('='.repeat(80));
      console.log(parsed);
      console.log('='.repeat(80));
      console.log('JSON String:');
      console.log(JSON.stringify(parsed, null, 2));
      console.log('='.repeat(80));
      
      showStatus('✅ JSON impreso en consola (abre DevTools para verlo)', 'success');
    } catch (error) {
      showStatus(`❌ Error: JSON inválido - ${error.message}`, 'error');
      console.error('Error al parsear JSON:', error);
    }
  });

  // Auto-save en localStorage y actualizar display
  let saveTimeout;
  editor.addEventListener('input', () => {
    syncDisplay();
    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => {
      localStorage.setItem('json-draft', editor.value);
      showStatus('💾 Guardado borrador localmente', 'info');
    }, 1000);
  });

  // Recuperar borrador si existe
  const draft = localStorage.getItem('json-draft');
  if (draft && confirm('Se encontró un borrador guardado. ¿Desea recuperarlo?')) {
    editor.value = draft;
    syncDisplay();
    showStatus('📄 Borrador recuperado', 'info');
  }

  // Atajos de teclado
  editor.addEventListener('keydown', (e) => {
    // Ctrl/Cmd + S para formatear
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      formatBtn.click();
    }
    
    // Ctrl/Cmd + Enter para imprimir en consola
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      consoleBtn.click();
    }

    // Tab para indentar
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = editor.selectionStart;
      const end = editor.selectionEnd;
      editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
      editor.selectionStart = editor.selectionEnd = start + 2;
    }
  });
</script>

<style is:global>

  .actions {
    position: fixed;
    display: flex;
    gap: 1rem;
    width: 40%;
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-bg-darker);
    background-color: color-mix(in srgb, var(--color-bg) 50%, transparent);
    backdrop-filter: blur(5px);
    z-index: 10;
  }

  .editor-wrapper {
    width: 100%;
    position: relative;
    display: flex;
    padding: 0.2rem;
    border: 1px solid var(--color-muted);
    border-radius: 4px;
    background-color: var(--color-muted);
    overflow: hidden;
  }

  .line-numbers {
    position: relative;
    z-index: 1;
    padding: 1rem 0.5rem;
    background: var(--color-bg-darker);
    color: var(--color-secondary-muted);
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
    text-align: right;
    user-select: none;
    border-right: 1px solid var(--color-muted);
    overflow: hidden;
    min-width: 3rem;
  }

  .line-number {
    height: 22.4px;
  }

  .json-display {
    position: absolute;
    top: 0.2rem;
    left: calc(3rem + 0.5rem + 1px);
    right: 0.2rem;
    bottom: 0.2rem;
    padding: 1rem;
    margin: 0;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 4px;
    overflow: hidden;
    pointer-events: none;
    white-space: pre;
    word-wrap: normal;
  }
  
  .json-display::-webkit-scrollbar {
    display: none;
  }

  #jsonEditor {
    position: absolute;
    top: 0.2rem;
    left: calc(3rem + 0.5rem + 1px);
    right: 0.2rem;
    bottom: 0.2rem;
    width: calc(100% - 3rem - 0.5rem - 1px - 0.4rem);
    field-sizing: content;
    padding: 1rem;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
    background: transparent;
    color: transparent;
    caret-color: var(--color-text);
    border-radius: 4px;
    border: none;
    resize: none;
    outline: none;
    overflow: hidden;
    white-space: pre;
    word-wrap: normal;
  }

  #jsonEditor::selection {
    background: rgba(137, 63, 59, 0.5);
  }

  /* Syntax highlighting colors */
  .json-key {
    color: var(--color-secondary-glow);
    text-shadow: 0 0 8px var(--color-secondary-glow);
  }

  .json-string {
    color: var(--color-text);
  }

  .json-number {
    color: #FFB86C;
  }

  .json-boolean {
    color: #FF79C6;
  }

  .json-null {
    color: var(--color-muted);
  }

  .json-bracket {
    color: var(--color-glow);
    text-shadow: 0 0 8px var(--color-glow);
  }

  .status {
    position: fixed;
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px;
    border-radius: 6px;
    font-size: 14px;
    min-height: 45px;
    display: flex;
    align-items: center;
    background: var(--color-bg-darker);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .status.success {
    opacity: 1;
    border: 1px solid var(--color-secondary-glow);
    box-shadow: 0 0 10px var(--color-secondary-glow);
  }

  .status.error {
    opacity: 1;
    border: 1px solid var(--color-glow);
    box-shadow: 0 0 10px var(--color-glow);
  }

  .status.info {
    opacity: 1;
    background-color: var(--color-secondary-accent);
    color: var(--color-bg);
    border: 1px solid var(--color-secondary-glow);
    box-shadow: 0 0 10px var(--color-secondary-glow);
  }

  /* Scrollbar personalizado */
  #jsonEditor::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  #jsonEditor::-webkit-scrollbar-track {
    background: var(--color-bg-darker);
  }

  #jsonEditor::-webkit-scrollbar-thumb {
    background: var(--color-bg-lighter);
    border-radius: 6px;
  }

  #jsonEditor::-webkit-scrollbar-thumb:hover {
    background: var(--color-muted);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      padding: 10px;
    }

    header {
      flex-direction: column;
      gap: 15px;
      align-items: flex-start;
    }

    .actions {
      width: 100%;
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>