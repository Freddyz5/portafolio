---

<section>
  <NavBarJson links={menuJson}/>
  <article class="json-viewer">
    <JsonNode node={data} />
  </article>
  <ButtonGlitch
    id="previewBtn"
    className="btn primary"
    text="Ver preview"
  />
</section>

<script type="module">
	function collectValues(container) {
		const inputs = container.querySelectorAll("input[data-key], textarea[data-key]");
		const result = {};
		inputs.forEach((input) => {
			const keys = input.dataset.key.split(".");
			let current = result;
			keys.forEach((k, i) => {
				if (i === keys.length - 1) {
					current[k] = input.value;
				} else {
					if (!current[k]) current[k] = isNaN(Number(keys[i + 1])) ? {} : [];
					current = current[k];
				}
			});
		});
		return result;
	}

	document.getElementById("previewBtn").addEventListener("click", () => {
		const container = document.querySelector(".json-viewer");
		const updatedData = collectValues(container);
		console.log("--- JSON preview ---");
		console.log(JSON.stringify(updatedData, null, 2));
	});
</script>

<style>
  section {
    width: 100%;
    padding: 1em;
  }
</style>
