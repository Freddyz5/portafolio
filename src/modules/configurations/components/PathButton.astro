---
interface Props {
	dataKey: any;
	type?: "array" | "object";
}

const { dataKey, type } = Astro.props;
---

<button
  class={`path-btn ${type ? type : ''}`}
  data-path={dataKey}
>
  +
</button>

<script>
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (target.classList.contains('path-btn')) {
			const path = target.dataset.path;
			if (path) {
				const formattedPath = path.replace(/\.(\d+)/g, '[$1]');
				console.log(`📍 Ruta: ${formattedPath}`);
			}
		}
	});
</script>

<style>
	.path-btn {
    background-color: #141414c0;
		border: 2px solid #FFF7ED;
    color: #FFF7ED;
		padding: 0rem 0.4rem;
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.4rem;
    font-weight: bold;
		transition: all 0.3s ease;
		flex-shrink: 0;
	}

  .object {
    background-color: #141414c0;
		border: 2px solid #00f2ea;
    color: #00f2ea;
  }

	.array {
		background: #141414c0;
		border-color: #fda400;
		color: #fda400;
	}

	.path-btn:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #fff7edd9;
		transform: scale(1.5);
	}

	.object:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #00f2ead9;
	}

	.array:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #fda400d9;
	}

	.path-btn:active {
		transform: scale(0.95);
	}
</style>
