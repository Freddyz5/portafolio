---
import ButtonGlitch from 'src/shared/compontens/ButtonGlitch.astro';

interface Props {
  data: any;
	dataKey: string;
	type?: "array" | "object";
}

const { data, dataKey, type } = Astro.props;
---
<>
  <button
    id={`pathBtn-${dataKey}`}
    class={`path-btn ${type ? type : ''}`}
    data-path={dataKey}
  >
    +
  </button>

  <div id={`modifyContentJson-${dataKey}`} class="modal">
    <div class="modal-content">
      <h2>Ruta: {dataKey}</h2>
      <div class="modal-actions">
        <button id={`cancelBtn-${dataKey}`} class="btn-cancel">
          Cancelar
        </button>
        <ButtonGlitch
          id={`confirmBtn-${dataKey}`}
          className="btn primary"
          text="Confirmar"
        />
      </div>
    </div>
  </div>
</>

<script type="module" define:vars={{ data, dataKey }}>
  // json-utils.js — utilidades para manipular JSON de forma inmutable y segura en Astro

  // Convierte paths como "works[0].teams[1]" en ["works", "0", "teams", "1"]
  const parsePath = (path) => path.replace(/\[(\w+)\]/g, ".$1").split('.');

  // Obtiene un clon profundo para evitar mutar el original
  const deepClone = (obj) => structuredClone(obj);

  // Navega hasta el penúltimo nivel del path
  const getTarget = (obj, path) => {
    const last = path.pop();
    if (!last) return null;
    let current = obj;
    for (const part of path) {
      if (current[part] == null) return null;
      current = current[part];
    }
    return [current, last];
  };

  export function addAttribute(obj, path, key, value) {
    const copy = deepClone(obj);
    const parsed = parsePath(path);
    const target = getTarget(copy, parsed);
    if (target) {
      const [current] = target;
      if (typeof current === 'object') current[key] = value;
    }
    return copy;
  }

  export function pushToArray(obj, path, value) {
    const copy = deepClone(obj);
    const parsed = parsePath(path);
    const target = getTarget(copy, parsed);
    if (target) {
      const [current, last] = target;
      if (Array.isArray(current[last])) current[last].push(value);
    }
    return copy;
  }

  export function mergeObject(obj, path, data) {
    const copy = deepClone(obj);
    const parsed = parsePath(path);
    const target = getTarget(copy, parsed);
    if (target) {
      const [current, last] = target;
      if (typeof current[last] === 'object') Object.assign(current[last], data);
    }
    return copy;
  }

  export function deleteAttribute(obj, path) {
    const copy = deepClone(obj);
    const parsed = parsePath(path);
    const target = getTarget(copy, parsed);
    if (target) {
      const [current, last] = target;
      if (typeof current === 'object' && last in current) delete current[last];
    }
    return copy;
  }

  export function removeFromArray(obj, path, condition) {
    const copy = deepClone(obj);
    const parsed = parsePath(path);
    const target = getTarget(copy, parsed);
    if (target) {
      const [current, last] = target;
      const arr = current[last];
      if (Array.isArray(arr)) {
        if (typeof condition === 'number') arr.splice(condition, 1);
        else {
          const index = arr.findIndex(condition);
          if (index !== -1) arr.splice(index, 1);
        }
      }
    }
    return copy;
  }

  document.getElementById(`pathBtn-${dataKey}`).addEventListener("click", () => {
		const modal = document.getElementById(`modifyContentJson-${dataKey}`);
		
		modal.style.display = "flex";
		
		setTimeout(() => accessKeyInput.focus(), 100);
	});

	// Manejar el botón de confirmar
	document.getElementById(`confirmBtn-${dataKey}`).addEventListener("click", async () => {
		const modal = document.getElementById(`modifyContentJson-${dataKey}`);
		// const accessKeyInput = document.getElementById("accessKeyInput");

    // Test no implementado aun
    const newData = addAttribute(data, dataKey, 'nuevo', 'valor');

    console.log("Datos modificados:", newData);

    modal.style.display = "none";

    console.log("Confirmar modificación en la ruta:", dataKey);

	});

  // Manejar el botón de cancelar
	document.getElementById(`cancelBtn-${dataKey}`).addEventListener("click", () => {
		const modal = document.getElementById(`modifyContentJson-${dataKey}`);
		modal.style.display = "none";
	});

	// Cerrar modal al presionar Escape
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			const modal = document.getElementById(`modifyContentJson-${dataKey}`);
			modal.style.display = "none";
		}
	});

	// Cerrar modal al hacer clic fuera del contenido
	document.getElementById(`modifyContentJson-${dataKey}`).addEventListener("click", (e) => {
		if (e.target.id === `modifyContentJson-${dataKey}`) {
			e.target.style.display = "none";
		}
	});

	// Permitir enviar con Enter
	document.getElementById("accessKeyInput").addEventListener("keydown", (e) => {
		if (e.key === "Enter") {
			document.getElementById("confirmBtn").click();
		}
	});
</script>

<style>
	.path-btn {
    background-color: #141414c0;
		border: 2px solid #FFF7ED;
    color: #FFF7ED;
		padding: 0rem 0.4rem;
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.4rem;
    font-weight: bold;
		transition: all 0.3s ease;
		flex-shrink: 0;
	}

  .object {
    background-color: #141414c0;
		border: 2px solid #00f2ea;
    color: #00f2ea;
  }

	.array {
		background: #141414c0;
		border-color: #fda400;
		color: #fda400;
	}

	.path-btn:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #fff7edd9;
		transform: scale(1.5);
	}

	.object:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #00f2ead9;
	}

	.array:hover {
		border: 1px solid #141414;
    color: #141414;
    background-color: #fda400d9;
	}

	.path-btn:active {
		transform: scale(0.95);
	}
  
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.136);
    backdrop-filter: blur(15px);
    justify-content: center;
    align-items: center;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .modal-content {
    background-color: #141414c8;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    max-width: 450px;
    width: 90%;
    animation: slideIn 0.3s ease;
    border: 1px solid #fff7edc0;
  }

  @keyframes slideIn {
    from {
      transform: translateY(-50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-content h2 {
    margin: 0 0 0.5rem 0;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .modal-content p {
    margin: 0 0 1.5rem 0;
    color: #fff7edc0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .modal-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    justify-content: flex-end;
  }

  .btn-cancel {
    background: rgba(255, 0, 0, 0.1);
    color: #fff;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border: 2px solid transparent;
  }

  .btn-cancel:hover {
    background: transparent;
    border: 2px solid rgb(255, 0, 0);
    color: #ff0000;
    transform: translateY(-1px);
  }

  .btn-cancel:active {
    transform: translateY(0);
  }
</style>
