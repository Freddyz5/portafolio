{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "moduleResolution": "node",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@cv": [
        "./src/cv/cv.json"
      ],
      "@es": [
        "./src/languages/es.json"
      ],
      "@en": [
        "./src/languages/en.json"
      ]
    }
  },
  "include": ["**/*.ts", "test"]
}